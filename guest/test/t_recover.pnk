/* t_recover.pnk -- verify transaction public-key recovery against the
   public keys carried by a StatelessInput.

   The input supplies one 65-byte SEC1 public key per payload transaction.
   Each output record is the recovered sender address, or zeroes when the
   transaction path raises TxErr. */
#include "config.h"
#include "types.h"
#include "lib/mem.pnk"
#include "lib/arith.pnk"
#include "lib/u256.pnk"
#include "lib/sha256.pnk"
#include "lib/keccak.pnk"
#include "lib/rlp.pnk"
#include "ssz.pnk"
#include "tx.pnk"
#include "lib/secp256k1.pnk"

fun 1 recover_one(1 txp, 1 txn, 1 pubkey65, 1 out20) {
  memzero(out20, 20);
  var 1 code = 0;
  var 1 tx = 0;
  try tx = decode_transaction(txp, txn)
  catch TxErr => code {
    return 0;
  }
  var {1,1} cid = <0, 0>;
  try cid = tx_chain_id(tx)
  catch TxErr => code {
    return 0;
  }
  try recover_sender_from_public_key(tx, cid.1, pubkey65, out20)
  catch TxErr => code {
    memzero(out20, 20);
    return 0;
  }
  return 0;
}

fun 1 main() {
  mem_init();
  sha256_init();
  keccak_init();
  u256_ws_init();
  secp256k1_init();
  ssz_init();
  var {1,1} inp = input_blob();
  var 1 si = decode_stateless_input(inp.0, inp.1);
  var 1 pl = lds 1 (si + SI_PL);
  var 1 txs = lds 1 (pl + PL_TXS);
  var 1 ntx = lds 1 (pl + PL_TXS_N);
  var 1 pubkeys = lds 1 (si + SI_PK);
  var 1 npk = lds 1 (si + SI_PK_N);
  var 1 out = alloc(ntx * 20 + 8);
  memzero(out, ntx * 20 + 8);
  var i = 0;
  while i <+ ntx {
    if i <+ npk {
      recover_one(SLICE_PTR(txs, i), SLICE_LEN(txs, i),
                  pubkeys + i * PUBKEY_SIZE, out + i * 20);
    }
    i = i + 1;
  }
  output_write(out, ntx * 20);
  @halt(@base, 0, @base, 0);
  return 0;
}
