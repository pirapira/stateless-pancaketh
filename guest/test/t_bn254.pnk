/* t_bn254.pnk -- exercise lib/bn254.pnk against tools/gen_bn254_vectors.py.
   Input: records [8 type LE][8 len LE][payload, zero padded to 8].
   Output: records [8 type][8 olen][payload padded to 8] with
     1 ECADD     payload = call data (any length, zero padded to 128 as the
                 precompile does) -> [8 err][64 point or zeros]
     2 ECMUL     call data (padded to 96) -> [8 err][64]
     3 PAIRING   call data -> [8 status] 0 false / 1 true / 2 invalid point /
                 3 length not a multiple of 192 (the precompile throws OOG)
     4 FQMUL     [32 a][32 b] -> [32 a*b mod p]
     5 PAIR_RAW  one valid 192-byte pair -> [384 pairing(q, p) coefficients BE]
     6 F12MUL    [384 a][384 b] -> [384]
     7 F12INV    [384 a] -> [384]
     8 FROB      [384 a] -> [384 a^p] */
#include "config.h"
#include "lib/mem.pnk"
#include "lib/arith.pnk"
#include "lib/u256.pnk"
#include "lib/keccak.pnk"
#include "lib/secp256k1.pnk"
#include "lib/bn254.pnk"

/* Zero-padded copy of the first size bytes of the n-byte buffer at src. */
fun 1 pad_read(1 src, 1 n, 1 size, 1 dst) {
  var 1 m = min(n, size);
  memcpy(dst, src, m);
  memzero(dst + m, size - m);
  return 0;
}

/* 12 BE integers at src -> Fq12 (Montgomery) at dst, and back. */
fun 1 f12_read(1 dst, 1 src) {
  var i = 0;
  while i <+ 12 {
    var U256 c = u256_from_be(src + i * 32, 32);
    c = fq_to_mont(c);
    st dst + i * 32, c;
    i = i + 1;
  }
  return 0;
}

fun 1 f12_write(1 dst, 1 src) {
  var i = 0;
  while i <+ 12 {
    var U256 c = lds U256 (src + i * 32);
    c = fq_from_mont(c);
    u256_to_be32(c, dst + i * 32);
    i = i + 1;
  }
  return 0;
}

fun 1 main() {
  mem_init();
  u256_ws_init();
  bn254_init();
  var {1,1} inp = input_blob();
  var 1 out = alloc(262144);
  var pos = 0;
  var opos = 0;
  while pos <+ inp.1 {
    var ty = lds 1 (inp.0 + pos);
    var len = lds 1 (inp.0 + pos + 8);
    var pl = inp.0 + pos + 16;
    var o = out + opos;
    st o, ty;
    var olen = 0;
    var mark = heap_mark();
    if ty == 1 {
      var 1 buf = alloc(128);
      pad_read(pl, len, 128, buf);
      var 1 e = bn254_g1_add(buf, o + 24);
      st o + 16, e;
      if e != 0 {
        memzero(o + 24, 64);
      }
      olen = 72;
    }
    if ty == 2 {
      var 1 buf2 = alloc(96);
      pad_read(pl, len, 96, buf2);
      var 1 e2 = bn254_g1_mul(buf2, o + 24);
      st o + 16, e2;
      if e2 != 0 {
        memzero(o + 24, 64);
      }
      olen = 72;
    }
    if ty == 3 {
      var {1,1} qr = udivmod(len, 192);
      var 1 res = 3;
      if qr.1 == 0 {
        res = bn254_pairing_check(pl, qr.0);
      }
      st o + 16, res;
      olen = 8;
    }
    if ty == 4 {
      var U256 a = u256_from_be(pl, 32);
      var U256 b = u256_from_be(pl + 32, 32);
      a = fq_to_mont(a);
      b = fq_to_mont(b);
      var U256 r = fq_mul(a, b);
      r = fq_from_mont(r);
      u256_to_be32(r, o + 16);
      olen = 32;
    }
    if ty == 5 {
      var 1 g1 = alloc(96);
      var 1 g2 = alloc(192);
      var 1 f = alloc(384);
      bn254_parse_g1(pl, g1);
      bn254_parse_g2(pl + 64, g2);
      bn254_pairing(f, g2, g1);
      f12_write(o + 16, f);
      olen = 384;
    }
    if ty == 6 {
      var 1 fa = alloc(384);
      var 1 fb = alloc(384);
      f12_read(fa, pl);
      f12_read(fb, pl + 384);
      fq12_mul(fa, fa, fb);
      f12_write(o + 16, fa);
      olen = 384;
    }
    if ty == 7 {
      var 1 fc = alloc(384);
      f12_read(fc, pl);
      fq12_inv(fc, fc);
      f12_write(o + 16, fc);
      olen = 384;
    }
    if ty == 8 {
      var 1 fd = alloc(384);
      f12_read(fd, pl);
      fq12_frob(fd, fd);
      f12_write(o + 16, fd);
      olen = 384;
    }
    heap_release(mark);
    st o + 8, olen;
    opos = opos + 16 + ((olen + 7) & (0 - 8));
    pos = pos + 16 + ((len + 7) & (0 - 8));
  }
  output_write(out, opos);
  @halt(@base, 0, @base, 0);
  return 0;
}
