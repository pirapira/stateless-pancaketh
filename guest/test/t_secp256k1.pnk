/* t_secp256k1.pnk -- exercise lib/secp256k1.pnk against tools/gen_secp_vectors.py.
   Input: N cases of 104 bytes [32 msg_hash][32 r][32 s][8 recid LE].
   Output per case (112 bytes): [8 ok LE][64 point x||y BE or zeros]
   [8 ok2 LE][20 address or zeros][12 zero pad], where ok2/address come from
   secp256k1_ecrecover with v = recid + 27.  SECP_SIMPLE_MUL (cpp) selects the
   u256_mulmod field multiply for cross-checking. */
#include "config.h"
#include "lib/mem.pnk"
#include "lib/arith.pnk"
#include "lib/u256.pnk"
#include "lib/keccak.pnk"
#include "lib/secp256k1.pnk"

#define CASE_IN 104
#define CASE_OUT 112

fun 1 main() {
  mem_init();
  keccak_init();
  u256_ws_init();
  secp256k1_init();
  var {1,1} inp = input_blob();
  var {1,1} nq = udivmod(inp.1, CASE_IN);
  var 1 ncase = nq.0;
  var 1 out = alloc(ncase * CASE_OUT);
  memzero(out, ncase * CASE_OUT);
  var c = 0;
  while c <+ ncase {
    var p = inp.0 + c * CASE_IN;
    var o = out + c * CASE_OUT;
    var U256 r = u256_from_be(p + 32, 32);
    var U256 s = u256_from_be(p + 64, 32);
    var recid = lds 1 (p + 96);
    var 1 ok = secp256k1_recover(p, r, s, recid, o + 8);
    st o, ok;
    if ok == 0 {
      memzero(o + 8, 64);
    }
    var 1 ok2 = secp256k1_ecrecover(p, recid + 27, r, s, o + 80);
    st o + 72, ok2;
    if ok2 == 0 {
      memzero(o + 80, 32);
    }
    c = c + 1;
  }
  output_write(out, ncase * CASE_OUT);
  @halt(@base, 0, @base, 0);
  return 0;
}
