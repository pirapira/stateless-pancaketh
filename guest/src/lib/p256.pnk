/* lib/p256.pnk -- secp256r1 (NIST P-256) ECDSA signature verification, the
   P256VERIFY precompile of EIP-7951 (address 0x100, Amsterdam).
   Port of evm-asm/execution-specs/src/ethereum/forks/amsterdam/vm/
   precompiled_contracts/p256verify.py and ethereum/crypto/elliptic_curve.py
   (SECP256R1P/N/A/B, is_on_curve_secp256r1, secp256r1_verify); the Lean table
   (SpecRef/Precompiles.lean) still lists p256verify as unimplemented.
     p256_verify(hash32, r, s, qx, qy) -> 1/0:
       0 < r < n, 0 < s < n                 (signature component bounds)
       qx < p, qy < p, (qx, qy) != (0, 0)   (public key bounds / not infinity)
       qy^2 == qx^3 - 3 qx + b (mod p)      (is_on_curve_secp256r1)
       u1 = e s^-1, u2 = r s^-1 (mod n), e = hash as a big-endian integer
       R = u1 G + u2 Q, R != O, R.x mod n == r   (textbook ECDSA, what the
       `cryptography` library called by secp256r1_verify computes)
   The precompile wrapper (precompiles_p256.pnk) adds the 160-byte length
   check, the gas and the 32-byte output.

   Points are Jacobian (X, Y, Z), (x, y) = (X / Z^2, Y / Z^3), stored as 3 U256
   in memory (X +0, Y +32, Z +64), Z == 0 encodes the identity; same layout and
   same group-law case split as lib/secp256k1.pnk.  Doubling uses the a = -3
   formula (dbl-2001-b: 3M + 5S).  The final R.x mod n == r test avoids the
   inversion: with x = X / Z^2 and x < p < 2n it is X == r Z^2 or, when
   r + n < p, X == (r + n) Z^2.

   Field multiplication: the 32-bit-digit comba product (as secp256k1) reduced
   by the NIST P-256 Solinas identity (Hankerson-Menezes-Vanstone Alg. 2.29):
   the 16 product digits combine into 8 signed sums, carries are propagated
   with arithmetic shifts, and the small signed top word (in [-4, 5]) is
   folded by adding / subtracting p.  -DP256_SIMPLE_MUL selects u256_mulmod
   instead (cross-check).  Inversions mod p and mod n are modinv_bin from
   lib/secp256k1.pnk; scalar (mod n) products use u256_mulmod (two per
   verification).  Needs lib/mem.pnk, lib/arith.pnk, lib/u256.pnk,
   lib/secp256k1.pnk (modinv_bin, mod_half, mod_sub).
   Constants are 4 signed-decimal LE limbs generated by Python (see
   tools/gen_p256_vectors.py for the hex values). */

/* p = 2^256 - 2^224 + 2^192 + 2^96 - 1 */
#define P256_P <-1, 4294967295, 0, -4294967295>
/* n = FFFFFFFF 00000000 FFFFFFFF FFFFFFFF BCE6FAAD A7179E84 F3B9CAC2 FC632551 */
#define P256_N <-884452912994769583, -4834901526196019580, -1, -4294967296>
#define P256_B <4309448131093880907, 7285987128567378166, -5482079946633869636, 6540974713487397863>
#define P256_GX <-819310685055303018, 8575836109218198432, -523289583788211982, 7716867327612699207>
#define P256_GY <-3767753221892779531, 3156516839386865358, -8149286295562117610, 5756518291402817435>

#define P256_X(pt) (pt)
#define P256_Y(pt) ((pt) + 32)
#define P256_Z(pt) ((pt) + 64)
#define P256_POINT_BYTES 96

/* ---------- field arithmetic mod p (inputs and outputs in [0, p)) ---------- */

fun U256 p256_fp_add(U256 a, U256 b) {
  var {1,1,1,1,1} s = u256_add_carry(a, b);
  var U256 r = <s.0, s.1, s.2, s.3>;
  if s.4 == 1 {
    return u256_sub(r, P256_P);
  }
  var 1 lt = u256_lt(r, P256_P);
  if lt == 0 {
    return u256_sub(r, P256_P);
  }
  return r;
}

fun U256 p256_fp_sub(U256 a, U256 b) {
  var 1 lt = u256_lt(a, b);
  var U256 d = u256_sub(a, b);
  if lt == 1 {
    d = u256_add(d, P256_P);
  }
  return d;
}

/* a mod p for a < 2^256 < 2p: one conditional subtraction. */
fun U256 p256_fp_reduce(U256 a) {
  var 1 lt = u256_lt(a, P256_P);
  if lt == 0 {
    return u256_sub(a, P256_P);
  }
  return a;
}

#ifdef P256_SIMPLE_MUL
fun U256 p256_fp_mul(U256 a, U256 b) {
  return u256_mulmod(a, b, P256_P);
}
fun U256 p256_fp_sqr(U256 a) {
  return u256_mulmod(a, a, P256_P);
}
#else
/* Comba product on 32-bit digits (see secp256k1.pnk fp_mul for the column
   scheme), then the Solinas reduction.  With c0..c15 the product digits,
   c == s1 + 2 s2 + 2 s3 + s4 + s5 - s6 - s7 - s8 - s9 (mod p) where
     s1 = (c7 .. c0)                   s2 = (c15 c14 c13 c12 c11 0 0 0)
     s3 = (0 c15 c14 c13 c12 0 0 0)    s4 = (c15 c14 0 0 0 c10 c9 c8)
     s5 = (c8 c13 c15 c14 c13 c11 c10 c9)  s6 = (c10 c8 0 0 0 c13 c12 c11)
     s7 = (c11 c9 0 0 c15 c14 c13 c12)     s8 = (c12 0 c10 c9 c8 c15 c14 c13)
     s9 = (c13 0 c11 c10 c9 0 c15 c14)     (most significant digit first).
   The 8 digit sums are small signed 64-bit values; carries propagate with the
   arithmetic shift, leaving a value t * 2^256 + R with t in [-4, 5], which is
   folded by |t| additions / subtractions of p and a final reduction. */
#define P256_FOLD_RETURN \
  d15 = c; \
  var t0 = d0 + d8 + d9 - d11 - d12 - d13 - d14; \
  var t1 = d1 + d9 + d10 - d12 - d13 - d14 - d15; \
  var t2 = d2 + d10 + d11 - d13 - d14 - d15; \
  var t3 = d3 + d11 + d11 + d12 + d12 + d13 - d15 - d8 - d9; \
  var t4 = d4 + d12 + d12 + d13 + d13 + d14 - d9 - d10; \
  var t5 = d5 + d13 + d13 + d14 + d14 + d15 - d10 - d11; \
  var t6 = d6 + d14 + d14 + d15 + d15 + d14 + d13 - d8 - d9; \
  var t7 = d7 + d15 + d15 + d15 + d8 - d10 - d11 - d12 - d13; \
  var v0 = t0 & M32; c = t0 >> 32; \
  col = t1 + c; var v1 = col & M32; c = col >> 32; \
  col = t2 + c; var v2 = col & M32; c = col >> 32; \
  col = t3 + c; var v3 = col & M32; c = col >> 32; \
  col = t4 + c; var v4 = col & M32; c = col >> 32; \
  col = t5 + c; var v5 = col & M32; c = col >> 32; \
  col = t6 + c; var v6 = col & M32; c = col >> 32; \
  col = t7 + c; var v7 = col & M32; c = col >> 32; \
  var U256 r = <v0 | (v1 << 32), v2 | (v3 << 32), v4 | (v5 << 32), v6 | (v7 << 32)>; \
  while c < 0 { \
    var {1,1,1,1,1} sa = u256_add_carry(r, P256_P); \
    r = <sa.0, sa.1, sa.2, sa.3>; \
    c = c + sa.4; \
  } \
  while c > 0 { \
    var 1 ltp = u256_lt(r, P256_P); \
    r = u256_sub(r, P256_P); \
    c = c - ltp; \
  } \
  return p256_fp_reduce(r);
#define P256_PRD(x, y) p = (x) * (y); L = L + (p & M32); H = H + (p >>> 32);
#define P256_COL(dk) col = L + c; dk = col & M32; c = (col >>> 32) + H; L = 0; H = 0;
fun U256 p256_fp_mul(U256 a, U256 b) {
  var a0 = a.0 & M32;
  var a1 = a.0 >>> 32;
  var a2 = a.1 & M32;
  var a3 = a.1 >>> 32;
  var a4 = a.2 & M32;
  var a5 = a.2 >>> 32;
  var a6 = a.3 & M32;
  var a7 = a.3 >>> 32;
  var b0 = b.0 & M32;
  var b1 = b.0 >>> 32;
  var b2 = b.1 & M32;
  var b3 = b.1 >>> 32;
  var b4 = b.2 & M32;
  var b5 = b.2 >>> 32;
  var b6 = b.3 & M32;
  var b7 = b.3 >>> 32;
  var p = 0;
  var L = 0;
  var H = 0;
  var c = 0;
  var col = 0;
  var d0 = 0; var d1 = 0; var d2 = 0; var d3 = 0;
  var d4 = 0; var d5 = 0; var d6 = 0; var d7 = 0;
  var d8 = 0; var d9 = 0; var d10 = 0; var d11 = 0;
  var d12 = 0; var d13 = 0; var d14 = 0; var d15 = 0;
  P256_PRD(a0, b0)
  P256_COL(d0)
  P256_PRD(a0, b1) P256_PRD(a1, b0)
  P256_COL(d1)
  P256_PRD(a0, b2) P256_PRD(a1, b1) P256_PRD(a2, b0)
  P256_COL(d2)
  P256_PRD(a0, b3) P256_PRD(a1, b2) P256_PRD(a2, b1) P256_PRD(a3, b0)
  P256_COL(d3)
  P256_PRD(a0, b4) P256_PRD(a1, b3) P256_PRD(a2, b2) P256_PRD(a3, b1) P256_PRD(a4, b0)
  P256_COL(d4)
  P256_PRD(a0, b5) P256_PRD(a1, b4) P256_PRD(a2, b3) P256_PRD(a3, b2) P256_PRD(a4, b1) P256_PRD(a5, b0)
  P256_COL(d5)
  P256_PRD(a0, b6) P256_PRD(a1, b5) P256_PRD(a2, b4) P256_PRD(a3, b3) P256_PRD(a4, b2) P256_PRD(a5, b1) P256_PRD(a6, b0)
  P256_COL(d6)
  P256_PRD(a0, b7) P256_PRD(a1, b6) P256_PRD(a2, b5) P256_PRD(a3, b4) P256_PRD(a4, b3) P256_PRD(a5, b2) P256_PRD(a6, b1) P256_PRD(a7, b0)
  P256_COL(d7)
  P256_PRD(a1, b7) P256_PRD(a2, b6) P256_PRD(a3, b5) P256_PRD(a4, b4) P256_PRD(a5, b3) P256_PRD(a6, b2) P256_PRD(a7, b1)
  P256_COL(d8)
  P256_PRD(a2, b7) P256_PRD(a3, b6) P256_PRD(a4, b5) P256_PRD(a5, b4) P256_PRD(a6, b3) P256_PRD(a7, b2)
  P256_COL(d9)
  P256_PRD(a3, b7) P256_PRD(a4, b6) P256_PRD(a5, b5) P256_PRD(a6, b4) P256_PRD(a7, b3)
  P256_COL(d10)
  P256_PRD(a4, b7) P256_PRD(a5, b6) P256_PRD(a6, b5) P256_PRD(a7, b4)
  P256_COL(d11)
  P256_PRD(a5, b7) P256_PRD(a6, b6) P256_PRD(a7, b5)
  P256_COL(d12)
  P256_PRD(a6, b7) P256_PRD(a7, b6)
  P256_COL(d13)
  P256_PRD(a7, b7)
  P256_COL(d14)
  P256_FOLD_RETURN
}

/* a^2 mod p: symmetric products once (i < j) into Lc/Hc, doubled per column. */
#define P256_PRC(x, y) p = (x) * (y); Lc = Lc + (p & M32); Hc = Hc + (p >>> 32);
#define P256_COLS(dk) L = L + Lc + Lc; H = H + Hc + Hc; Lc = 0; Hc = 0; P256_COL(dk)
fun U256 p256_fp_sqr(U256 a) {
  var a0 = a.0 & M32;
  var a1 = a.0 >>> 32;
  var a2 = a.1 & M32;
  var a3 = a.1 >>> 32;
  var a4 = a.2 & M32;
  var a5 = a.2 >>> 32;
  var a6 = a.3 & M32;
  var a7 = a.3 >>> 32;
  var p = 0;
  var L = 0;
  var H = 0;
  var Lc = 0;
  var Hc = 0;
  var c = 0;
  var col = 0;
  var d0 = 0; var d1 = 0; var d2 = 0; var d3 = 0;
  var d4 = 0; var d5 = 0; var d6 = 0; var d7 = 0;
  var d8 = 0; var d9 = 0; var d10 = 0; var d11 = 0;
  var d12 = 0; var d13 = 0; var d14 = 0; var d15 = 0;
  P256_PRD(a0, a0)
  P256_COLS(d0)
  P256_PRC(a0, a1)
  P256_COLS(d1)
  P256_PRC(a0, a2) P256_PRD(a1, a1)
  P256_COLS(d2)
  P256_PRC(a0, a3) P256_PRC(a1, a2)
  P256_COLS(d3)
  P256_PRC(a0, a4) P256_PRC(a1, a3) P256_PRD(a2, a2)
  P256_COLS(d4)
  P256_PRC(a0, a5) P256_PRC(a1, a4) P256_PRC(a2, a3)
  P256_COLS(d5)
  P256_PRC(a0, a6) P256_PRC(a1, a5) P256_PRC(a2, a4) P256_PRD(a3, a3)
  P256_COLS(d6)
  P256_PRC(a0, a7) P256_PRC(a1, a6) P256_PRC(a2, a5) P256_PRC(a3, a4)
  P256_COLS(d7)
  P256_PRC(a1, a7) P256_PRC(a2, a6) P256_PRC(a3, a5) P256_PRD(a4, a4)
  P256_COLS(d8)
  P256_PRC(a2, a7) P256_PRC(a3, a6) P256_PRC(a4, a5)
  P256_COLS(d9)
  P256_PRC(a3, a7) P256_PRC(a4, a6) P256_PRD(a5, a5)
  P256_COLS(d10)
  P256_PRC(a4, a7) P256_PRC(a5, a6)
  P256_COLS(d11)
  P256_PRC(a5, a7) P256_PRD(a6, a6)
  P256_COLS(d12)
  P256_PRC(a6, a7)
  P256_COLS(d13)
  P256_PRD(a7, a7)
  P256_COLS(d14)
  P256_FOLD_RETURN
}
#endif

/* a^-1 mod p (0 for a == 0). */
fun U256 p256_fp_inv(U256 a) {
  return modinv_bin(a, P256_P);
}

/* ---------- Jacobian point arithmetic (points in memory, see header) ---------- */

fun 1 p256_set_infinity(1 pt) {
  st P256_X(pt), <1, 0, 0, 0>;
  st P256_Y(pt), <1, 0, 0, 0>;
  st P256_Z(pt), U256_ZERO;
  return 0;
}

fun 1 p256_set_affine(1 pt, U256 x, U256 y) {
  st P256_X(pt), x;
  st P256_Y(pt), y;
  st P256_Z(pt), <1, 0, 0, 0>;
  return 0;
}

/* pt = 2 * pt (a = -3 doubling, dbl-2001-b).  Y == 0 (no such point on the
   curve, kept for the group-law case split) gives the identity. */
fun 1 p256_ec_double(1 pt) {
  var U256 z = lds U256 P256_Z(pt);
  var 1 zz = u256_is_zero(z);
  if zz == 1 {
    return 0;
  }
  var U256 y = lds U256 P256_Y(pt);
  var 1 yz = u256_is_zero(y);
  if yz == 1 {
    p256_set_infinity(pt);
    return 0;
  }
  var U256 x = lds U256 P256_X(pt);
  var U256 delta = p256_fp_sqr(z);             /* Z^2 */
  var U256 gamma = p256_fp_sqr(y);             /* Y^2 */
  var U256 beta = p256_fp_mul(x, gamma);       /* X Y^2 */
  var U256 t1 = p256_fp_sub(x, delta);
  var U256 t2 = p256_fp_add(x, delta);
  var U256 alpha = p256_fp_mul(t1, t2);
  var U256 alpha2 = p256_fp_add(alpha, alpha);
  alpha = p256_fp_add(alpha2, alpha);          /* alpha = 3 (X - Z^2)(X + Z^2) */
  var U256 x3 = p256_fp_sqr(alpha);
  var U256 b4 = p256_fp_add(beta, beta);
  b4 = p256_fp_add(b4, b4);                    /* 4 beta */
  var U256 b8 = p256_fp_add(b4, b4);
  x3 = p256_fp_sub(x3, b8);                    /* X3 = alpha^2 - 8 beta */
  var U256 z3 = p256_fp_add(y, z);
  z3 = p256_fp_sqr(z3);
  z3 = p256_fp_sub(z3, gamma);
  z3 = p256_fp_sub(z3, delta);                 /* Z3 = (Y + Z)^2 - gamma - delta */
  var U256 y3 = p256_fp_sub(b4, x3);
  y3 = p256_fp_mul(alpha, y3);                 /* alpha (4 beta - X3) */
  var U256 g2 = p256_fp_sqr(gamma);
  g2 = p256_fp_add(g2, g2);
  g2 = p256_fp_add(g2, g2);
  g2 = p256_fp_add(g2, g2);                    /* 8 gamma^2 */
  y3 = p256_fp_sub(y3, g2);
  st P256_X(pt), x3;
  st P256_Y(pt), y3;
  st P256_Z(pt), z3;
  return 0;
}

/* pt = pt + (ax, ay), (ax, ay) affine (mixed addition, Z2 = 1); same-x case
   split: identity when the y coordinates cancel, else doubling. */
fun 1 p256_ec_add_affine(1 pt, U256 ax, U256 ay) {
  var U256 z1 = lds U256 P256_Z(pt);
  var 1 zz = u256_is_zero(z1);
  if zz == 1 {
    p256_set_affine(pt, ax, ay);
    return 0;
  }
  var U256 x1 = lds U256 P256_X(pt);
  var U256 y1 = lds U256 P256_Y(pt);
  var U256 z1z1 = p256_fp_sqr(z1);
  var U256 u2 = p256_fp_mul(ax, z1z1);         /* U2 = x2 Z1^2 */
  var U256 s2 = p256_fp_mul(z1, z1z1);
  s2 = p256_fp_mul(ay, s2);                    /* S2 = y2 Z1^3 */
  var 1 samex = u256_eq(u2, x1);
  if samex == 1 {
    var U256 ysum = p256_fp_add(s2, y1);
    var 1 ysz = u256_is_zero(ysum);
    if ysz == 1 {
      p256_set_infinity(pt);
      return 0;
    }
    p256_ec_double(pt);
    return 0;
  }
  var U256 h = p256_fp_sub(u2, x1);            /* H = U2 - X1 */
  var U256 rr = p256_fp_sub(s2, y1);           /* R = S2 - Y1 */
  var U256 hh = p256_fp_sqr(h);
  var U256 hhh = p256_fp_mul(h, hh);
  var U256 v = p256_fp_mul(x1, hh);            /* V = X1 H^2 */
  var U256 x3 = p256_fp_sqr(rr);
  x3 = p256_fp_sub(x3, hhh);
  var U256 v2 = p256_fp_add(v, v);
  x3 = p256_fp_sub(x3, v2);                    /* X3 = R^2 - H^3 - 2V */
  var U256 y3 = p256_fp_sub(v, x3);
  y3 = p256_fp_mul(rr, y3);
  var U256 t = p256_fp_mul(y1, hhh);
  y3 = p256_fp_sub(y3, t);                     /* Y3 = R (V - X3) - Y1 H^3 */
  var U256 z3 = p256_fp_mul(z1, h);            /* Z3 = Z1 H */
  st P256_X(pt), x3;
  st P256_Y(pt), y3;
  st P256_Z(pt), z3;
  return 0;
}

/* out = k1 * (ax, ay) + k2 * (bx, by): joint (Shamir) MSB-first
   double-and-add, one doubling per bit then up to two mixed additions. */
fun 1 p256_ec_mul2(1 out, U256 k1, U256 ax, U256 ay, U256 k2, U256 bx, U256 by) {
  p256_set_infinity(out);
  var 1 len1 = u256_bit_length(k1);
  var 1 len2 = u256_bit_length(k2);
  var 1 i = max(len1, len2);
  while i >+ 0 {
    i = i - 1;
    p256_ec_double(out);
    var 1 bit1 = u256_bit(k1, i);
    if bit1 == 1 {
      p256_ec_add_affine(out, ax, ay);
    }
    var 1 bit2 = u256_bit(k2, i);
    if bit2 == 1 {
      p256_ec_add_affine(out, bx, by);
    }
  }
  return 0;
}

/* Normalise pt to affine (X, Y, 1); returns 0 (and leaves pt) at infinity. */
fun 1 p256_ec_to_affine(1 pt) {
  var U256 z = lds U256 P256_Z(pt);
  var 1 zz = u256_is_zero(z);
  if zz == 1 {
    return 0;
  }
  var U256 zi = p256_fp_inv(z);
  var U256 zi2 = p256_fp_sqr(zi);
  var U256 zi3 = p256_fp_mul(zi2, zi);
  var U256 x = lds U256 P256_X(pt);
  var U256 y = lds U256 P256_Y(pt);
  x = p256_fp_mul(x, zi2);
  y = p256_fp_mul(y, zi3);
  p256_set_affine(pt, x, y);
  return 1;
}

/* is_on_curve_secp256r1: y^2 == x^3 - 3x + b (mod p), for x, y < p. */
fun 1 p256_on_curve(U256 x, U256 y) {
  var U256 l = p256_fp_sqr(y);
  var U256 r = p256_fp_sqr(x);
  r = p256_fp_mul(r, x);                       /* x^3 */
  var U256 x3 = p256_fp_add(x, x);
  x3 = p256_fp_add(x3, x);                     /* 3x */
  r = p256_fp_sub(r, x3);
  r = p256_fp_add(r, P256_B);
  return u256_eq(l, r);
}

/* ---------- verification ---------- */

/* p256verify.py after the length check.  hash32: 32 big-endian bytes; r, s:
   signature; (qx, qy): public key.  Returns 1 iff the signature verifies. */
fun 1 p256_verify(1 hash32, U256 r, U256 s, U256 qx, U256 qy) {
  var 1 rz = u256_is_zero(r);
  if rz == 1 { return 0; }
  var 1 rlt = u256_lt(r, P256_N);
  if rlt == 0 { return 0; }
  var 1 sz = u256_is_zero(s);
  if sz == 1 { return 0; }
  var 1 slt = u256_lt(s, P256_N);
  if slt == 0 { return 0; }
  var 1 xlt = u256_lt(qx, P256_P);
  if xlt == 0 { return 0; }
  var 1 ylt = u256_lt(qy, P256_P);
  if ylt == 0 { return 0; }
  if (qx.0 | qx.1 | qx.2 | qx.3 | qy.0 | qy.1 | qy.2 | qy.3) == 0 { return 0; }
  var 1 onc = p256_on_curve(qx, qy);
  if onc == 0 { return 0; }
  /* e = hash mod n: hash < 2^256 < 2n, one conditional subtraction */
  var U256 e = u256_from_be(hash32, 32);
  var 1 elt = u256_lt(e, P256_N);
  if elt == 0 {
    e = u256_sub(e, P256_N);
  }
  var U256 sinv = modinv_bin(s, P256_N);
  var U256 u1 = u256_mulmod(e, sinv, P256_N);
  var U256 u2 = u256_mulmod(r, sinv, P256_N);
  var mark = heap_mark();
  var pr = alloc(P256_POINT_BYTES);
  p256_ec_mul2(pr, u1, P256_GX, P256_GY, u2, qx, qy);
  var U256 z = lds U256 P256_Z(pr);
  var 1 zz = u256_is_zero(z);
  if zz == 1 {
    heap_release(mark);
    return 0;                                  /* R at infinity */
  }
  /* R.x mod n == r  <=>  X == r Z^2 or (r + n < p and X == (r + n) Z^2) */
  var U256 z2 = p256_fp_sqr(z);
  var U256 x = lds U256 P256_X(pr);
  heap_release(mark);
  var U256 t = p256_fp_mul(r, z2);
  var 1 ok = u256_eq(t, x);
  if ok == 1 { return 1; }
  var {1,1,1,1,1} rn = u256_add_carry(r, P256_N);
  if rn.4 == 1 { return 0; }
  var U256 rn4 = <rn.0, rn.1, rn.2, rn.3>;
  var 1 rnlt = u256_lt(rn4, P256_P);
  if rnlt == 0 { return 0; }
  t = p256_fp_mul(rn4, z2);
  return u256_eq(t, x);
}
