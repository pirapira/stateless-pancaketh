/* lib/u256.pnk -- 256-bit unsigned / two's-complement signed integers.
   A U256 is the struct {1,1,1,1}: four little-endian 64-bit limbs, .0 least
   significant.  In memory: 4 words, limb 0 at the lowest address.
   All functions are pure on struct values; division uses a private scratch
   area (allocated lazily from the heap) for Knuth algorithm D on 32-bit digits.
   Semantics follow the EVM (div/mod by zero give 0; SDIV/SMOD truncate toward
   zero; MIN / -1 = MIN).  Needs lib/mem.pnk and lib/arith.pnk. */

#define U256 {1,1,1,1}
#define U512 {1,1,1,1,1,1,1,1}
#define ALLONES (0 - 1)
#define B32 4294967296
#define U256_ZERO <0, 0, 0, 0>
#define U256_ONES <ALLONES, ALLONES, ALLONES, ALLONES>

/* Scratch layout (byte offsets; every 32-bit digit occupies one word). */
#define WS_UN 0      /* 18 words: normalised dividend */
#define WS_VN 144    /* 9 words: normalised divisor */
#define WS_Q 216     /* 17 words: quotient digits */
#define WS_R 352     /* 9 words: remainder digits */
#define WS_U 424     /* 17 words: dividend digits */
#define WS_V 560     /* 9 words: divisor digits */
#define WS_SIZE 640

var 1 u256_ws = 0;

fun 1 u256_ws_init() {
  if u256_ws == 0 {
    u256_ws = alloc(WS_SIZE);
  }
  return 0;
}

/* ---------- construction / inspection ---------- */

fun U256 u256_from_word(1 w) {
  return <w, 0, 0, 0>;
}

fun 1 u256_low(U256 a) {
  return a.0;
}

fun 1 u256_fits_word(U256 a) {
  if (a.1 | a.2 | a.3) == 0 { return 1; }
  return 0;
}

fun 1 u256_is_zero(U256 a) {
  if (a.0 | a.1 | a.2 | a.3) == 0 { return 1; }
  return 0;
}

/* Limb i (0..3); 0 for i >= 4. */
fun 1 u256_limb(U256 a, 1 i) {
  if i == 0 { return a.0; }
  if i == 1 { return a.1; }
  if i == 2 { return a.2; }
  if i == 3 { return a.3; }
  return 0;
}

/* Bit t (0 = least significant); 0 for t >= 256. */
fun 1 u256_bit(U256 a, 1 t) {
  if t >=+ 256 { return 0; }
  var 1 l = u256_limb(a, t >>> 6);
  return (l >>> (t & 63)) & 1;
}

/* ---------- comparisons ---------- */

fun 1 u256_eq(U256 a, U256 b) {
  if ((a.0 ^ b.0) | (a.1 ^ b.1) | (a.2 ^ b.2) | (a.3 ^ b.3)) == 0 { return 1; }
  return 0;
}

fun 1 u256_lt(U256 a, U256 b) {
  if a.3 != b.3 { if a.3 <+ b.3 { return 1; } return 0; }
  if a.2 != b.2 { if a.2 <+ b.2 { return 1; } return 0; }
  if a.1 != b.1 { if a.1 <+ b.1 { return 1; } return 0; }
  if a.0 <+ b.0 { return 1; }
  return 0;
}

fun 1 u256_gt(U256 a, U256 b) {
  return u256_lt(b, a);
}

/* Signed (two's complement) less-than. */
fun 1 u256_slt(U256 a, U256 b) {
  if a.3 != b.3 { if a.3 < b.3 { return 1; } return 0; }
  if a.2 != b.2 { if a.2 <+ b.2 { return 1; } return 0; }
  if a.1 != b.1 { if a.1 <+ b.1 { return 1; } return 0; }
  if a.0 <+ b.0 { return 1; }
  return 0;
}

fun 1 u256_sgt(U256 a, U256 b) {
  return u256_slt(b, a);
}

/* Unsigned three-way compare: 0 if a < b, 1 if a == b, 2 if a > b. */
fun 1 u256_cmp(U256 a, U256 b) {
  var 1 lt = u256_lt(a, b);
  if lt == 1 { return 0; }
  var 1 eq = u256_eq(a, b);
  if eq == 1 { return 1; }
  return 2;
}

/* ---------- bitwise ---------- */

fun U256 u256_not(U256 a) {
  return <a.0 ^ ALLONES, a.1 ^ ALLONES, a.2 ^ ALLONES, a.3 ^ ALLONES>;
}

fun U256 u256_and(U256 a, U256 b) {
  return <a.0 & b.0, a.1 & b.1, a.2 & b.2, a.3 & b.3>;
}

fun U256 u256_or(U256 a, U256 b) {
  return <a.0 | b.0, a.1 | b.1, a.2 | b.2, a.3 | b.3>;
}

fun U256 u256_xor(U256 a, U256 b) {
  return <a.0 ^ b.0, a.1 ^ b.1, a.2 ^ b.2, a.3 ^ b.3>;
}

/* ---------- addition / subtraction ---------- */

/* <limb0..limb3, carry_out> of a + b. */
fun {1,1,1,1,1} u256_add_carry(U256 a, U256 b) {
  var {1,1} r0 = __add_with_carry__(a.0, b.0, 0);
  var {1,1} r1 = __add_with_carry__(a.1, b.1, r0.1);
  var {1,1} r2 = __add_with_carry__(a.2, b.2, r1.1);
  var {1,1} r3 = __add_with_carry__(a.3, b.3, r2.1);
  return <r0.0, r1.0, r2.0, r3.0, r3.1>;
}

fun U256 u256_add(U256 a, U256 b) {
  var {1,1} r0 = __add_with_carry__(a.0, b.0, 0);
  var {1,1} r1 = __add_with_carry__(a.1, b.1, r0.1);
  var {1,1} r2 = __add_with_carry__(a.2, b.2, r1.1);
  var {1,1} r3 = __add_with_carry__(a.3, b.3, r2.1);
  return <r0.0, r1.0, r2.0, r3.0>;
}

/* a - b mod 2^256 (= a + ~b + 1). */
fun U256 u256_sub(U256 a, U256 b) {
  var {1,1} r0 = __add_with_carry__(a.0, b.0 ^ ALLONES, 1);
  var {1,1} r1 = __add_with_carry__(a.1, b.1 ^ ALLONES, r0.1);
  var {1,1} r2 = __add_with_carry__(a.2, b.2 ^ ALLONES, r1.1);
  var {1,1} r3 = __add_with_carry__(a.3, b.3 ^ ALLONES, r2.1);
  return <r0.0, r1.0, r2.0, r3.0>;
}

fun U256 u256_neg(U256 a) {
  var {1,1} r0 = __add_with_carry__(0, a.0 ^ ALLONES, 1);
  var {1,1} r1 = __add_with_carry__(0, a.1 ^ ALLONES, r0.1);
  var {1,1} r2 = __add_with_carry__(0, a.2 ^ ALLONES, r1.1);
  var {1,1} r3 = __add_with_carry__(0, a.3 ^ ALLONES, r2.1);
  return <r0.0, r1.0, r2.0, r3.0>;
}

/* ---------- multiplication ---------- */

/* Full 64x64 -> 128 product as <lo, hi>, via 32-bit halves. */
fun {1,1} mul64x64(1 a, 1 b) {
  var a0 = a & M32;
  var a1 = a >>> 32;
  var b0 = b & M32;
  var b1 = b >>> 32;
  var p00 = a0 * b0;
  var p11 = a1 * b1;
  var {1,1} mid = __add_with_carry__(a0 * b1, a1 * b0, 0);
  var {1,1} lo = __add_with_carry__(p00, mid.0 << 32, 0);
  var hi = p11 + (mid.0 >>> 32) + (mid.1 << 32) + lo.1;
  return <lo.0, hi>;
}

/* Column accumulator: acc/hi is a 128-bit running sum. */
#define ACC(x) t = __add_with_carry__(acc, (x), 0); acc = t.0; hi = hi + t.1;
#define NEXTCOL acc = hi; hi = 0;

/* a * b mod 2^256. */
fun U256 u256_mul(U256 a, U256 b) {
  if ((a.1 | a.2 | a.3 | b.1 | b.2 | b.3)) == 0 {
    var {1,1} p = mul64x64(a.0, b.0);
    return <p.0, p.1, 0, 0>;
  }
  var {1,1} p00 = mul64x64(a.0, b.0);
  var {1,1} p01 = mul64x64(a.0, b.1);
  var {1,1} p10 = mul64x64(a.1, b.0);
  var {1,1} p02 = mul64x64(a.0, b.2);
  var {1,1} p11 = mul64x64(a.1, b.1);
  var {1,1} p20 = mul64x64(a.2, b.0);
  var {1,1} t = <0, 0>;
  var acc = 0;
  var hi = 0;
  var r0 = p00.0;
  /* column 1 */
  acc = p00.1;
  ACC(p01.0)
  ACC(p10.0)
  var r1 = acc;
  NEXTCOL
  /* column 2 */
  ACC(p01.1)
  ACC(p10.1)
  ACC(p02.0)
  ACC(p11.0)
  ACC(p20.0)
  var r2 = acc;
  NEXTCOL
  /* column 3: only the low word matters, no carries needed */
  var r3 = acc + p02.1 + p11.1 + p20.1 + a.0 * b.3 + a.1 * b.2 + a.2 * b.1 + a.3 * b.0;
  return <r0, r1, r2, r3>;
}

/* Full 512-bit product, 8 little-endian limbs. */
fun U512 u256_mul_full(U256 a, U256 b) {
  var {1,1} p00 = mul64x64(a.0, b.0);
  var {1,1} p01 = mul64x64(a.0, b.1);
  var {1,1} p10 = mul64x64(a.1, b.0);
  var {1,1} p02 = mul64x64(a.0, b.2);
  var {1,1} p11 = mul64x64(a.1, b.1);
  var {1,1} p20 = mul64x64(a.2, b.0);
  var {1,1} p03 = mul64x64(a.0, b.3);
  var {1,1} p12 = mul64x64(a.1, b.2);
  var {1,1} p21 = mul64x64(a.2, b.1);
  var {1,1} p30 = mul64x64(a.3, b.0);
  var {1,1} p13 = mul64x64(a.1, b.3);
  var {1,1} p22 = mul64x64(a.2, b.2);
  var {1,1} p31 = mul64x64(a.3, b.1);
  var {1,1} p23 = mul64x64(a.2, b.3);
  var {1,1} p32 = mul64x64(a.3, b.2);
  var {1,1} p33 = mul64x64(a.3, b.3);
  var {1,1} t = <0, 0>;
  var acc = 0;
  var hi = 0;
  var r0 = p00.0;
  acc = p00.1;
  ACC(p01.0)
  ACC(p10.0)
  var r1 = acc;
  NEXTCOL
  ACC(p01.1)
  ACC(p10.1)
  ACC(p02.0)
  ACC(p11.0)
  ACC(p20.0)
  var r2 = acc;
  NEXTCOL
  ACC(p02.1)
  ACC(p11.1)
  ACC(p20.1)
  ACC(p03.0)
  ACC(p12.0)
  ACC(p21.0)
  ACC(p30.0)
  var r3 = acc;
  NEXTCOL
  ACC(p03.1)
  ACC(p12.1)
  ACC(p21.1)
  ACC(p30.1)
  ACC(p13.0)
  ACC(p22.0)
  ACC(p31.0)
  var r4 = acc;
  NEXTCOL
  ACC(p13.1)
  ACC(p22.1)
  ACC(p31.1)
  ACC(p23.0)
  ACC(p32.0)
  var r5 = acc;
  NEXTCOL
  ACC(p23.1)
  ACC(p32.1)
  ACC(p33.0)
  var r6 = acc;
  NEXTCOL
  var r7 = acc + p33.1;
  return <r0, r1, r2, r3, r4, r5, r6, r7>;
}

/* ---------- division on 32-bit digits (Knuth D, Hacker's Delight divmnu) ---------- */

/* Number of leading zero bits of a nonzero 32-bit value. */
fun 1 nlz32(1 x) {
  var s = 0;
  if (x & 4294901760) == 0 { s = s + 16; x = x << 16; }
  if (x & 4278190080) == 0 { s = s + 8; x = x << 8; }
  if (x & 4026531840) == 0 { s = s + 4; x = x << 4; }
  if (x & 3221225472) == 0 { s = s + 2; x = x << 2; }
  if (x & 2147483648) == 0 { s = s + 1; }
  return s;
}

/* <q, r> of (hi * 2^32 + lo) / d for 32-bit digits with hi < d (so q < 2^32). */
fun {1,1} div64by32(1 hi, 1 lo, 1 d) {
  var q = 0;
  var r = hi;
  var i = 32;
  while i > 0 {
    i = i - 1;
    r = (r << 1) | ((lo >>> i) & 1);
    if r >=+ d {
      r = r - d;
      q = q | (1 << i);
    }
  }
  return <q, r>;
}

/* Store a as 8 digits at p; load 8 digits from p. */
fun 1 u256_to_digits(1 p, U256 a) {
  st p, a.0 & M32;
  st p + 8, a.0 >>> 32;
  st p + 16, a.1 & M32;
  st p + 24, a.1 >>> 32;
  st p + 32, a.2 & M32;
  st p + 40, a.2 >>> 32;
  st p + 48, a.3 & M32;
  st p + 56, a.3 >>> 32;
  return 0;
}

fun U256 digits_to_u256(1 p) {
  return <(lds 1 p) | ((lds 1 (p + 8)) << 32),
          (lds 1 (p + 16)) | ((lds 1 (p + 24)) << 32),
          (lds 1 (p + 32)) | ((lds 1 (p + 40)) << 32),
          (lds 1 (p + 48)) | ((lds 1 (p + 56)) << 32)>;
}

/* Number of significant digits among the n digits at p. */
fun 1 digits_len(1 p, 1 n) {
  while n >+ 0 {
    if (lds 1 (p + (n - 1) * 8)) != 0 { return n; }
    n = n - 1;
  }
  return 0;
}

/* q[0..m) = u[0..m) / v[0..n), r[0..n) = remainder.  Requires 1 <= n <= m,
   v[n-1] != 0, all digits < 2^32.  Digits q[m-n+1..m) are set to 0. */
fun 1 divmnu(1 q, 1 r, 1 u, 1 m, 1 v, 1 n) {
  var i = 0;
  var j = 0;
  if n == 1 {
    var d = lds 1 v;
    var k = 0;
    j = m;
    while j >+ 0 {
      j = j - 1;
      var {1,1} qr = div64by32(k, lds 1 (u + j * 8), d);
      st q + j * 8, qr.0;
      k = qr.1;
    }
    st r, k;
    return 0;
  }
  var un = u256_ws + WS_UN;
  var vn = u256_ws + WS_VN;
  var s = nlz32(lds 1 (v + (n - 1) * 8));
  i = n - 1;
  while i >+ 0 {
    st vn + i * 8, (((lds 1 (v + i * 8)) << s) | ((lds 1 (v + (i - 1) * 8)) >>> (32 - s))) & M32;
    i = i - 1;
  }
  st vn, ((lds 1 v) << s) & M32;
  st un + m * 8, (lds 1 (u + (m - 1) * 8)) >>> (32 - s);
  i = m - 1;
  while i >+ 0 {
    st un + i * 8, (((lds 1 (u + i * 8)) << s) | ((lds 1 (u + (i - 1) * 8)) >>> (32 - s))) & M32;
    i = i - 1;
  }
  st un, ((lds 1 u) << s) & M32;
  var vtop = lds 1 (vn + (n - 1) * 8);
  var vsec = lds 1 (vn + (n - 2) * 8);
  j = m - n + 1;
  while j >+ 0 {
    j = j - 1;
    var ujn = lds 1 (un + (j + n) * 8);
    var ujn1 = lds 1 (un + (j + n - 1) * 8);
    var ujn2 = lds 1 (un + (j + n - 2) * 8);
    var qhat = 0;
    var rhat = 0;
    if ujn >=+ vtop {
      /* ujn == vtop: clamp qhat to b - 1 */
      qhat = M32;
      rhat = ((ujn << 32) | ujn1) - qhat * vtop;
    } else {
      var {1,1} qr = div64by32(ujn, ujn1, vtop);
      qhat = qr.0;
      rhat = qr.1;
    }
    var again = 1;
    while again == 1 {
      again = 0;
      if rhat <+ B32 {
        if (qhat * vsec) >+ ((rhat << 32) | ujn2) {
          qhat = qhat - 1;
          rhat = rhat + vtop;
          again = 1;
        }
      }
    }
    /* multiply and subtract */
    var k = 0;
    i = 0;
    while i <+ n {
      var p = qhat * (lds 1 (vn + i * 8));
      var t = (lds 1 (un + (i + j) * 8)) - k - (p & M32);
      st un + (i + j) * 8, t & M32;
      k = (p >>> 32) - (t >> 32);
      i = i + 1;
    }
    var tt = ujn - k;
    if tt < 0 {
      st q + j * 8, qhat - 1;
      k = 0;
      i = 0;
      while i <+ n {
        var t2 = (lds 1 (un + (i + j) * 8)) + (lds 1 (vn + i * 8)) + k;
        st un + (i + j) * 8, t2 & M32;
        k = t2 >>> 32;
        i = i + 1;
      }
      st un + (j + n) * 8, (tt + k) & M32;
    } else {
      st q + j * 8, qhat;
      st un + (j + n) * 8, tt;
    }
  }
  j = m - n + 1;
  while j <+ m {
    st q + j * 8, 0;
    j = j + 1;
  }
  /* unnormalise the remainder */
  i = 0;
  while i <+ n {
    st r + i * 8, ((lds 1 (un + i * 8)) >>> s) | (((lds 1 (un + (i + 1) * 8)) << (32 - s)) & M32);
    i = i + 1;
  }
  return 0;
}

/* Divide the m (<= 16) digits at u (u is clobbered) by the nonzero d.
   Quotient digits land in u256_ws + WS_Q (16 digits); returns the remainder. */
fun U256 digits_divmod(1 u, 1 m, U256 d) {
  var q = u256_ws + WS_Q;
  var r = u256_ws + WS_R;
  var v = u256_ws + WS_V;
  u256_to_digits(v, d);
  var 1 n = digits_len(v, 8);
  var 1 mm = digits_len(u, m);
  var i = 0;
  while i <+ 16 {
    st q + i * 8, 0;
    i = i + 1;
  }
  if mm <+ n {
    return digits_to_u256(u);
  }
  i = 0;
  while i <+ 8 {
    st r + i * 8, 0;
    i = i + 1;
  }
  divmnu(q, r, u, mm, v, n);
  return digits_to_u256(r);
}

/* <q0..q3, r0..r3> = <a / b, a mod b>; both 0 when b == 0 (EVM). */
fun U512 u256_divmod(U256 a, U256 b) {
  if (b.0 | b.1 | b.2 | b.3) == 0 {
    return <0, 0, 0, 0, 0, 0, 0, 0>;
  }
  var 1 lt = u256_lt(a, b);
  if lt == 1 {
    return <0, 0, 0, 0, a.0, a.1, a.2, a.3>;
  }
  if (a.1 | a.2 | a.3 | b.1 | b.2 | b.3) == 0 {
    var {1,1} qr = udivmod(a.0, b.0);
    return <qr.0, 0, 0, 0, qr.1, 0, 0, 0>;
  }
  u256_ws_init();
  var u = u256_ws + WS_U;
  u256_to_digits(u, a);
  var U256 r = digits_divmod(u, 8, b);
  var U256 q = digits_to_u256(u256_ws + WS_Q);
  return <q.0, q.1, q.2, q.3, r.0, r.1, r.2, r.3>;
}

fun U256 u256_div(U256 a, U256 b) {
  var U512 qr = u256_divmod(a, b);
  return <qr.0, qr.1, qr.2, qr.3>;
}

fun U256 u256_mod(U256 a, U256 b) {
  var U512 qr = u256_divmod(a, b);
  return <qr.4, qr.5, qr.6, qr.7>;
}

/* |a| for two's complement a (MIN maps to 2^255, which is fine unsigned). */
fun U256 u256_abs(U256 a) {
  if (a.3 >>> 63) == 1 {
    return u256_neg(a);
  }
  return a;
}

/* EVM SDIV: truncated toward zero; b == 0 -> 0; MIN / -1 = MIN. */
fun U256 u256_sdiv(U256 a, U256 b) {
  if (b.0 | b.1 | b.2 | b.3) == 0 {
    return U256_ZERO;
  }
  var U256 aa = u256_abs(a);
  var U256 bb = u256_abs(b);
  var U256 q = u256_div(aa, bb);
  if ((a.3 ^ b.3) >>> 63) == 1 {
    return u256_neg(q);
  }
  return q;
}

/* EVM SMOD: sign follows the dividend; b == 0 -> 0. */
fun U256 u256_smod(U256 a, U256 b) {
  if (b.0 | b.1 | b.2 | b.3) == 0 {
    return U256_ZERO;
  }
  var U256 aa = u256_abs(a);
  var U256 bb = u256_abs(b);
  var U256 r = u256_mod(aa, bb);
  if (a.3 >>> 63) == 1 {
    return u256_neg(r);
  }
  return r;
}

/* (a + b) mod m over the exact 257-bit sum; m == 0 -> 0. */
fun U256 u256_addmod(U256 a, U256 b, U256 m) {
  if (m.0 | m.1 | m.2 | m.3) == 0 {
    return U256_ZERO;
  }
  var {1,1,1,1,1} s = u256_add_carry(a, b);
  var U256 sum = <s.0, s.1, s.2, s.3>;
  if s.4 == 0 {
    return u256_mod(sum, m);
  }
  u256_ws_init();
  var u = u256_ws + WS_U;
  u256_to_digits(u, sum);
  st u + 64, 1;
  st u + 72, 0;
  return digits_divmod(u, 10, m);
}

/* (a * b) mod m over the exact 512-bit product; m == 0 -> 0. */
fun U256 u256_mulmod(U256 a, U256 b, U256 m) {
  if (m.0 | m.1 | m.2 | m.3) == 0 {
    return U256_ZERO;
  }
  u256_ws_init();
  var u = u256_ws + WS_U;
  if (a.1 | a.2 | a.3 | b.1 | b.2 | b.3) == 0 {
    var {1,1} p = mul64x64(a.0, b.0);
    if p.1 == 0 {
      return u256_mod(<p.0, 0, 0, 0>, m);
    }
    u256_to_digits(u, <p.0, p.1, 0, 0>);
    return digits_divmod(u, 4, m);
  }
  var U512 f = u256_mul_full(a, b);
  u256_to_digits(u, <f.0, f.1, f.2, f.3>);
  u256_to_digits(u + 64, <f.4, f.5, f.6, f.7>);
  return digits_divmod(u, 16, m);
}

/* ---------- bit lengths ---------- */

fun 1 bit_length64(1 x) {
  var n = 0;
  if (x >>> 32) != 0 { n = n + 32; x = x >>> 32; }
  if (x >>> 16) != 0 { n = n + 16; x = x >>> 16; }
  if (x >>> 8) != 0 { n = n + 8; x = x >>> 8; }
  if (x >>> 4) != 0 { n = n + 4; x = x >>> 4; }
  if (x >>> 2) != 0 { n = n + 2; x = x >>> 2; }
  if (x >>> 1) != 0 { n = n + 1; x = x >>> 1; }
  return n + x;
}

/* Number of significant bits (0 for zero). */
fun 1 u256_bit_length(U256 a) {
  if a.3 != 0 { var 1 n3 = bit_length64(a.3); return 192 + n3; }
  if a.2 != 0 { var 1 n2 = bit_length64(a.2); return 128 + n2; }
  if a.1 != 0 { var 1 n1 = bit_length64(a.1); return 64 + n1; }
  return bit_length64(a.0);
}

/* Minimal big-endian byte length (0 for zero). */
fun 1 u256_byte_length(U256 a) {
  var 1 n = u256_bit_length(a);
  return (n + 7) >>> 3;
}

/* ---------- exponentiation ---------- */

/* a ^ b mod 2^256 by square-and-multiply. */
fun U256 u256_exp(U256 a, U256 b) {
  var U256 result = <1, 0, 0, 0>;
  var U256 base = a;
  var 1 len = u256_bit_length(b);
  var t = 0;
  while t <+ len {
    var 1 bit = u256_bit(b, t);
    if bit == 1 {
      result = u256_mul(result, base);
    }
    t = t + 1;
    if t <+ len {
      base = u256_mul(base, base);
    }
  }
  return result;
}

/* ---------- shifts ---------- */

fun U256 u256_shl(U256 a, 1 n) {
  if n >=+ 256 { return U256_ZERO; }
  var w = n >>> 6;
  var s = n & 63;
  var l0 = a.0;
  var l1 = a.1;
  var l2 = a.2;
  var l3 = a.3;
  if w == 1 { l3 = l2; l2 = l1; l1 = l0; l0 = 0; }
  if w == 2 { l3 = l1; l2 = l0; l1 = 0; l0 = 0; }
  if w == 3 { l3 = l0; l2 = 0; l1 = 0; l0 = 0; }
  if s != 0 {
    l3 = (l3 << s) | (l2 >>> (64 - s));
    l2 = (l2 << s) | (l1 >>> (64 - s));
    l1 = (l1 << s) | (l0 >>> (64 - s));
    l0 = l0 << s;
  }
  return <l0, l1, l2, l3>;
}

fun U256 u256_shr(U256 a, 1 n) {
  if n >=+ 256 { return U256_ZERO; }
  var w = n >>> 6;
  var s = n & 63;
  var l0 = a.0;
  var l1 = a.1;
  var l2 = a.2;
  var l3 = a.3;
  if w == 1 { l0 = l1; l1 = l2; l2 = l3; l3 = 0; }
  if w == 2 { l0 = l2; l1 = l3; l2 = 0; l3 = 0; }
  if w == 3 { l0 = l3; l1 = 0; l2 = 0; l3 = 0; }
  if s != 0 {
    l0 = (l0 >>> s) | (l1 << (64 - s));
    l1 = (l1 >>> s) | (l2 << (64 - s));
    l2 = (l2 >>> s) | (l3 << (64 - s));
    l3 = l3 >>> s;
  }
  return <l0, l1, l2, l3>;
}

/* Arithmetic shift right (sign fill). */
fun U256 u256_sar(U256 a, 1 n) {
  var neg = a.3 >>> 63;
  if n >=+ 256 {
    if neg == 1 { return U256_ONES; }
    return U256_ZERO;
  }
  var U256 r = u256_shr(a, n);
  if neg == 1 {
    if n != 0 {
      var U256 mask = u256_shl(U256_ONES, 256 - n);
      r = u256_or(r, mask);
    }
  }
  return r;
}

/* EVM SIGNEXTEND: extend from byte b (0 = lowest byte); b >= 31 -> x. */
fun U256 u256_signextend(1 b, U256 x) {
  if b >=+ 31 { return x; }
  var t = b * 8 + 7;
  var 1 bit = u256_bit(x, t);
  var U256 mask = u256_shl(U256_ONES, t + 1);
  if bit == 1 {
    return u256_or(x, mask);
  }
  var U256 nm = u256_not(mask);
  return u256_and(x, nm);
}

/* EVM BYTE: i-th byte of the big-endian encoding (0 = most significant). */
fun 1 u256_byte(1 i, U256 x) {
  if i >=+ 32 { return 0; }
  var pos = (31 - i) * 8;
  var 1 l = u256_limb(x, pos >>> 6);
  return (l >>> (pos & 63)) & 255;
}

/* ---------- byte conversion ---------- */

/* Big-endian n (<= 32) bytes at p -> U256. */
fun U256 u256_from_be(1 p, 1 n) {
  if (n == 32) && ((p & 7) == 0) {
    var 1 w = lds 1 p;
    var 1 l3 = bswap64(w);
    w = lds 1 (p + 8);
    var 1 l2 = bswap64(w);
    w = lds 1 (p + 16);
    var 1 l1 = bswap64(w);
    w = lds 1 (p + 24);
    var 1 l0 = bswap64(w);
    return <l0, l1, l2, l3>;
  }
  var l0 = 0;
  var l1 = 0;
  var l2 = 0;
  var l3 = 0;
  var i = 0;
  while i <+ n {
    var pos = n - 1 - i;
    var byte = (ld8 (p + i)) << ((pos & 7) * 8);
    var w = pos >>> 3;
    if w == 0 { l0 = l0 | byte; }
    if w == 1 { l1 = l1 | byte; }
    if w == 2 { l2 = l2 | byte; }
    if w == 3 { l3 = l3 | byte; }
    i = i + 1;
  }
  return <l0, l1, l2, l3>;
}

/* 32-byte big-endian encoding at out. */
fun 1 u256_to_be32(U256 a, 1 out) {
  if (out & 7) == 0 {
    var 1 w = bswap64(a.3);
    st out, w;
    w = bswap64(a.2);
    st out + 8, w;
    w = bswap64(a.1);
    st out + 16, w;
    w = bswap64(a.0);
    st out + 24, w;
    return 0;
  }
  st_be64(out, a.3);
  st_be64(out + 8, a.2);
  st_be64(out + 16, a.1);
  st_be64(out + 24, a.0);
  return 0;
}

/* Minimal big-endian encoding at out; returns its length (0 for zero). */
fun 1 u256_to_be_min(U256 a, 1 out) {
  var 1 len = u256_byte_length(a);
  var i = 0;
  while i <+ len {
    var pos = len - 1 - i;
    var 1 l = u256_limb(a, pos >>> 3);
    st8 out + i, (l >>> ((pos & 7) * 8)) & 255;
    i = i + 1;
  }
  return len;
}
