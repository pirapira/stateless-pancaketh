/* lib/htab.pnk -- open-addressing hash table: fixed-length byte keys ->
   one word value. Linear probing, backward-shift deletion, doubling at
   load factor 1/2. Used for the witness node DB / code DB (32-byte keys),
   account maps (20-byte keys) and storage maps (52-byte keys).
   Iteration order is unspecified (SpecRef uses insertion-ordered assoc
   lists, but every consumer sorts or is order-insensitive). */

#define HT_KEYLEN   0    /* key length in bytes */
#define HT_KEYSTRIDE 8   /* key length rounded up to 8 */
#define HT_CAP      16   /* capacity (power of two) */
#define HT_COUNT    24
#define HT_KEYS     32   /* ptr to cap * keystride bytes */
#define HT_VALS     40   /* ptr to cap words */
#define HT_USED     48   /* ptr to cap bytes (1 = occupied) */
#define HT_SIZE     56

fun 1 htab_new(1 key_len, 1 cap) {
  var 1 t = alloc(HT_SIZE);
  var stride = (key_len + 7) & (0 - 8);
  st t + HT_KEYLEN, key_len;
  st t + HT_KEYSTRIDE, stride;
  st t + HT_CAP, cap;
  st t + HT_COUNT, 0;
  var 1 keys = alloc(cap * stride);
  st t + HT_KEYS, keys;
  var 1 vals = alloc(cap * 8);
  st t + HT_VALS, vals;
  var 1 used = alloc(cap);
  memzero(used, cap);
  st t + HT_USED, used;
  return t;
}

/* Hash of key_len bytes at p (byte-wise FNV-1a style mix on words). */
fun 1 htab_hash(1 p, 1 key_len) {
  var h = 14695981039346656037;
  var i = 0;
  while i + 8 <=+ key_len {
    h = (h ^ LD_LE64(p + i)) * 1099511628211;
    h = h ^ (h >>> 29);
    i = i + 8;
  }
  while i <+ key_len {
    h = (h ^ (ld8 (p + i))) * 1099511628211;
    i = i + 1;
  }
  h = h ^ (h >>> 32);
  return h;
}

/* Slot index of key, or cap if absent. */
fun 1 htab_find_slot(1 t, 1 key) {
  !stw OUTPUT_ADDR + 104, t;
  !stw OUTPUT_ADDR + 112, key;
  var cap = lds 1 (t + HT_CAP);
  var klen = lds 1 (t + HT_KEYLEN);
  var stride = lds 1 (t + HT_KEYSTRIDE);
  var keys = lds 1 (t + HT_KEYS);
  var used = lds 1 (t + HT_USED);
  var 1 h = htab_hash(key, klen);
  var i = h & (cap - 1);
  while (ld8 (used + i)) != 0 {
    var 1 eq = memeq(keys + i * stride, key, klen);
    if eq != 0 {
      return i;
    }
    i = (i + 1) & (cap - 1);
  }
  return cap;
}

/* <found, value> */
fun {1,1} htab_get(1 t, 1 key) {
  var 1 i = htab_find_slot(t, key);
  if i == (lds 1 (t + HT_CAP)) {
    return <0, 0>;
  }
  return <1, lds 1 ((lds 1 (t + HT_VALS)) + i * 8)>;
}

fun 1 htab_has(1 t, 1 key) {
  var 1 i = htab_find_slot(t, key);
  if i == (lds 1 (t + HT_CAP)) {
    return 0;
  }
  return 1;
}

/* Insert without growth check (key known absent). */
fun 1 htab_insert_raw(1 t, 1 key, 1 value) {
  var cap = lds 1 (t + HT_CAP);
  var klen = lds 1 (t + HT_KEYLEN);
  var stride = lds 1 (t + HT_KEYSTRIDE);
  var keys = lds 1 (t + HT_KEYS);
  var used = lds 1 (t + HT_USED);
  var 1 h = htab_hash(key, klen);
  var i = h & (cap - 1);
  while (ld8 (used + i)) != 0 {
    i = (i + 1) & (cap - 1);
  }
  memcpy(keys + i * stride, key, klen);
  st (lds 1 (t + HT_VALS)) + i * 8, value;
  st8 used + i, 1;
  st t + HT_COUNT, (lds 1 (t + HT_COUNT)) + 1;
  return 0;
}

fun 1 htab_grow(1 t) {
  var cap = lds 1 (t + HT_CAP);
  var stride = lds 1 (t + HT_KEYSTRIDE);
  var keys = lds 1 (t + HT_KEYS);
  var vals = lds 1 (t + HT_VALS);
  var used = lds 1 (t + HT_USED);
  var ncap = cap * 2;
  var 1 nkeys = alloc(ncap * stride);
  var 1 nvals = alloc(ncap * 8);
  var 1 nused = alloc(ncap);
  memzero(nused, ncap);
  st t + HT_CAP, ncap;
  st t + HT_KEYS, nkeys;
  st t + HT_VALS, nvals;
  st t + HT_USED, nused;
  st t + HT_COUNT, 0;
  var i = 0;
  while i < cap {
    if (ld8 (used + i)) != 0 {
      htab_insert_raw(t, keys + i * stride, lds 1 (vals + i * 8));
    }
    i = i + 1;
  }
  return 0;
}

/* Insert or update. */
fun 1 htab_set(1 t, 1 key, 1 value) {
  var 1 i = htab_find_slot(t, key);
  if i != (lds 1 (t + HT_CAP)) {
    st (lds 1 (t + HT_VALS)) + i * 8, value;
    return 0;
  }
  if ((lds 1 (t + HT_COUNT)) + 1) * 2 >+ (lds 1 (t + HT_CAP)) {
    htab_grow(t);
  }
  htab_insert_raw(t, key, value);
  return 0;
}

/* Delete (backward-shift). Returns 1 if the key was present. */
fun 1 htab_del(1 t, 1 key) {
  var 1 i = htab_find_slot(t, key);
  var cap = lds 1 (t + HT_CAP);
  if i == cap {
    return 0;
  }
  var klen = lds 1 (t + HT_KEYLEN);
  var stride = lds 1 (t + HT_KEYSTRIDE);
  var keys = lds 1 (t + HT_KEYS);
  var vals = lds 1 (t + HT_VALS);
  var used = lds 1 (t + HT_USED);
  var j = i;
  while true {
    j = (j + 1) & (cap - 1);
    if (ld8 (used + j)) == 0 {
      break;
    }
    var 1 h = htab_hash(keys + j * stride, klen);
    var home = h & (cap - 1);
    /* can slot j move to slot i? yes if home is not in (i, j] cyclically */
    var movable = 0;
    if i <=+ j {
      if (home <=+ i) || (home >+ j) {
        movable = 1;
      }
    } else {
      if (home <=+ i) && (home >+ j) {
        movable = 1;
      }
    }
    if movable != 0 {
      memcpy(keys + i * stride, keys + j * stride, klen);
      st vals + i * 8, lds 1 (vals + j * 8);
      i = j;
    }
  }
  st8 used + i, 0;
  st t + HT_COUNT, (lds 1 (t + HT_COUNT)) - 1;
  return 1;
}

fun 1 htab_count(1 t) {
  return lds 1 (t + HT_COUNT);
}

fun 1 htab_cap(1 t) {
  return lds 1 (t + HT_CAP);
}

/* Slot i: <used, key ptr, value>. */
fun {1,1,1} htab_slot(1 t, 1 i) {
  var used = ld8 ((lds 1 (t + HT_USED)) + i);
  var keyp = (lds 1 (t + HT_KEYS)) + i * (lds 1 (t + HT_KEYSTRIDE));
  var val = lds 1 ((lds 1 (t + HT_VALS)) + i * 8);
  return <used, keyp, val>;
}

/* Copy all keys (packed at stride) into a fresh array; returns <ptr, count>. */
fun {1,1} htab_keys(1 t) {
  var cap = lds 1 (t + HT_CAP);
  var stride = lds 1 (t + HT_KEYSTRIDE);
  var n = lds 1 (t + HT_COUNT);
  var 1 out = alloc(n * stride + 8);
  var used = lds 1 (t + HT_USED);
  var keys = lds 1 (t + HT_KEYS);
  var i = 0;
  var k = 0;
  while i < cap {
    if (ld8 (used + i)) != 0 {
      memcpy(out + k * stride, keys + i * stride, stride);
      k = k + 1;
    }
    i = i + 1;
  }
  return <out, n>;
}

/* Shallow copy (same keys/values). */
fun 1 htab_copy(1 t) {
  var cap = lds 1 (t + HT_CAP);
  var stride = lds 1 (t + HT_KEYSTRIDE);
  var 1 n = alloc(HT_SIZE);
  memcpy(n, t, HT_SIZE);
  var 1 keys = alloc(cap * stride);
  memcpy(keys, lds 1 (t + HT_KEYS), cap * stride);
  st n + HT_KEYS, keys;
  var 1 vals = alloc(cap * 8);
  memcpy(vals, lds 1 (t + HT_VALS), cap * 8);
  st n + HT_VALS, vals;
  var 1 used = alloc(cap);
  memcpy(used, lds 1 (t + HT_USED), cap);
  st n + HT_USED, used;
  return n;
}
