  if err != 0 {
    throw EvmErr E_INVALID_PARAMETER;
  }
  st ev + EV_OUTPUT, out;
  st ev + EV_OUTPUT_N, 128;
  return 0;
}

fun 1 pre_bls_map_fp2_to_g2() {
  var msg = lds 1 (ev + EV_MSG);
  var n = lds 1 (msg + MSG_DATA_N);
  if n != BLS_G2MAP_LEN {
    throw EvmErr E_INVALID_PARAMETER;
  }
  charge_gas(BLS_G2MAP_GAS);
  var 1 out = alloc(256);
  var 1 err = bls_map_fp2_to_g2_exec(lds 1 (msg + MSG_DATA), out);
  if err != 0 {
    throw EvmErr E_INVALID_PARAMETER;
  }
  st ev + EV_OUTPUT, out;
  st ev + EV_OUTPUT_N, 256;
  return 0;
}
