fun 1 bls_g1_msm_discount(1 k) {
  if k >+ 128 {
    return 519;
  }
  return lds 1 (bls_discount + (k - 1) * 8);
}

fun 1 bls_g2_msm_discount(1 k) {
  if k >+ 128 {
    return 524;
  }
  return lds 1 (bls_discount + (128 + k - 1) * 8);
}

fun 1 pre_bls_g1_add() {
  var msg = lds 1 (ev + EV_MSG);
  var n = lds 1 (msg + MSG_DATA_N);
  if n != BLS_G1ADD_LEN {
    throw EvmErr E_INVALID_PARAMETER;
  }
  charge_gas(BLS_G1ADD_GAS);
  var 1 out = alloc(128);
  var 1 err = bls_g1_add_exec(lds 1 (msg + MSG_DATA), out);
  if err != 0 {
    throw EvmErr E_INVALID_PARAMETER;
  }
  st ev + EV_OUTPUT, out;
  st ev + EV_OUTPUT_N, 128;
  return 0;
}

fun 1 pre_bls_g1_msm() {
  var msg = lds 1 (ev + EV_MSG);
  var n = lds 1 (msg + MSG_DATA_N);
  if n == 0 {
    throw EvmErr E_INVALID_PARAMETER;
  }
  var {1,1} qr = udivmod(n, BLS_G1MSM_PAIR_LEN);
  if qr.1 != 0 {
    throw EvmErr E_INVALID_PARAMETER;
  }
  var 1 k = qr.0;
  var 1 discount = bls_g1_msm_discount(k);
  var {1,1} gasq = udivmod(k * BLS_G1MSM_BASE_GAS * discount, 1000);
  charge_gas(gasq.0);
  var 1 out = alloc(128);
  var 1 err = bls_g1_msm_exec(lds 1 (msg + MSG_DATA), k, out);
  if err != 0 {
    throw EvmErr E_INVALID_PARAMETER;
  }
  st ev + EV_OUTPUT, out;
  st ev + EV_OUTPUT_N, 128;
  return 0;
}

fun 1 pre_bls_g2_add() {
  var msg = lds 1 (ev + EV_MSG);
  var n = lds 1 (msg + MSG_DATA_N);
  if n != BLS_G2ADD_LEN {
    throw EvmErr E_INVALID_PARAMETER;
  }
  charge_gas(BLS_G2ADD_GAS);
  var 1 out = alloc(256);
  var 1 err = bls_g2_add_exec(lds 1 (msg + MSG_DATA), out);
  if err != 0 {
    throw EvmErr E_INVALID_PARAMETER;
  }
  st ev + EV_OUTPUT, out;
  st ev + EV_OUTPUT_N, 256;
  return 0;
}

fun 1 pre_bls_g2_msm() {
  var msg = lds 1 (ev + EV_MSG);
  var n = lds 1 (msg + MSG_DATA_N);
  if n == 0 {
    throw EvmErr E_INVALID_PARAMETER;
  }
  var {1,1} qr = udivmod(n, BLS_G2MSM_PAIR_LEN);
  if qr.1 != 0 {
    throw EvmErr E_INVALID_PARAMETER;
  }
  var 1 k = qr.0;
  var 1 discount = bls_g2_msm_discount(k);
  var {1,1} gasq = udivmod(k * BLS_G2MSM_BASE_GAS * discount, 1000);
  charge_gas(gasq.0);
  var 1 out = alloc(256);
  var 1 err = bls_g2_msm_exec(lds 1 (msg + MSG_DATA), k, out);
  if err != 0 {
    throw EvmErr E_INVALID_PARAMETER;
  }
  st ev + EV_OUTPUT, out;
  st ev + EV_OUTPUT_N, 256;
  return 0;
}

fun 1 pre_bls_pairing() {
  var msg = lds 1 (ev + EV_MSG);
  var n = lds 1 (msg + MSG_DATA_N);
  if n == 0 {
    throw EvmErr E_INVALID_PARAMETER;
  }
  var {1,1} qr = udivmod(n, BLS_PAIRING_PAIR_LEN);
  if qr.1 != 0 {
    throw EvmErr E_INVALID_PARAMETER;
  }
  var 1 k = qr.0;
  charge_gas(BLS_PAIRING_PAIR_GAS * k + BLS_PAIRING_BASE_GAS);
  var 1 out = alloc(32);
  var 1 err = bls_pairing_exec(lds 1 (msg + MSG_DATA), k, out);
  if err != 0 {
    throw EvmErr E_INVALID_PARAMETER;
  }
  st ev + EV_OUTPUT, out;
  st ev + EV_OUTPUT_N, 32;
  return 0;
}

