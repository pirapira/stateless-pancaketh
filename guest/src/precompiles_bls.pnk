/* precompiles_bls.pnk -- EIP-2537 BLS12-381 precompiles.
   Length errors are InvalidParameter before gas; malformed coordinates and
   subgroup failures are InvalidParameter after the gas charge, matching the
   Amsterdam execution-spec reference. */
#include "lib/bls12381_consts.pnk"

/* secp256k1 is already part of the main guest and owns the generic fp_*
   symbols.  Keep the BLS Fp implementation private when both libraries are
   included in one translation unit; the standalone BLS tests use the source
   names directly. */
#define fp_is_zero bls_fp_is_zero
#define fp_eq bls_fp_eq
#define fp_lt_raw bls_fp_lt_raw
#define fp_add_raw bls_fp_add_raw
#define fp_sub_raw bls_fp_sub_raw
#define fp_add bls_fp_add
#define fp_sub bls_fp_sub
#define fp_neg bls_fp_neg
#define fp_dbl bls_fp_dbl
#define fp_mul bls_fp_mul
#define fp_sqr bls_fp_sqr
#define fp_to_mont bls_fp_to_mont
#define fp_from_mont bls_fp_from_mont
#define fp_shr1 bls_fp_shr1
#define fp_half_can bls_fp_half_can
#define fp_inv_raw bls_fp_inv_raw
#define fp_inv bls_fp_inv
#define fp_pow bls_fp_pow
#define fp_sgn0 bls_fp_sgn0
#define fp_is_high bls_fp_is_high
#define fp_from_be48 bls_fp_from_be48
#define fp_to_be48 bls_fp_to_be48
#define fp_decode64 bls_fp_decode64
#define fp_encode64 bls_fp_encode64
#include "lib/fp384.pnk"
#include "lib/bls12381.pnk"
#undef fp_is_zero
#undef fp_eq
#undef fp_lt_raw
#undef fp_add_raw
#undef fp_sub_raw
#undef fp_add
#undef fp_sub
#undef fp_neg
#undef fp_dbl
#undef fp_mul
#undef fp_sqr
#undef fp_to_mont
#undef fp_from_mont
#undef fp_shr1
#undef fp_half_can
#undef fp_inv_raw
#undef fp_inv
#undef fp_pow
#undef fp_sgn0
#undef fp_is_high
#undef fp_from_be48
#undef fp_to_be48
#undef fp_decode64
#undef fp_encode64

#define BLS_G1ADD_GAS 375
#define BLS_G1MSM_BASE_GAS 12000
#define BLS_G2ADD_GAS 600
#define BLS_G2MSM_BASE_GAS 22500
#define BLS_PAIRING_BASE_GAS 37700
#define BLS_PAIRING_PAIR_GAS 32600
#define BLS_G1MAP_GAS 5500
#define BLS_G2MAP_GAS 23800
#define BLS_G1ADD_LEN 256
#define BLS_G1MSM_PAIR_LEN 160
#define BLS_G2ADD_LEN 512
#define BLS_G2MSM_PAIR_LEN 288
#define BLS_PAIRING_PAIR_LEN 384
#define BLS_G1MAP_LEN 64
#define BLS_G2MAP_LEN 128
#define BLS_DISCOUNT_WORDS 256

/* The EIP-2537 table has one 64-bit word per k for G1 followed by G2.
   It is initialized outside any frame scratch mark and remains live for the
   guest lifetime, like the generated BLS constants. */
var 1 bls_discount = 0;

