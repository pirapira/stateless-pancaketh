  return 0;
}

fun 1 op_smod() {
  var {1,1,1,1} x = stack_pop();
  var {1,1,1,1} y = stack_pop();
  charge_gas(5);
  var {1,1,1,1} r = u256_smod(x, y);
  stack_push(r);
  pc_add(1);
  return 0;
}

fun 1 op_addmod() {
  var {1,1,1,1} x = stack_pop();
  var {1,1,1,1} y = stack_pop();
  var {1,1,1,1} z = stack_pop();
  charge_gas(8);
  var {1,1,1,1} r = u256_addmod(x, y, z);
  stack_push(r);
  pc_add(1);
  return 0;
}

fun 1 op_mulmod() {
  var {1,1,1,1} x = stack_pop();
  var {1,1,1,1} y = stack_pop();
  var {1,1,1,1} z = stack_pop();
  charge_gas(8);
  var {1,1,1,1} r = u256_mulmod(x, y, z);
  stack_push(r);
  pc_add(1);
  return 0;
}

fun 1 op_exp() {
  var {1,1,1,1} base = stack_pop();
  var {1,1,1,1} exponent = stack_pop();
  var 1 nb = u256_byte_length(exponent);
  charge_gas(G_EXP_BASE + G_EXP_PER_BYTE * nb);
  var {1,1,1,1} r = u256_exp(base, exponent);
  stack_push(r);
  pc_add(1);
  return 0;
}

fun 1 op_signextend() {
  var {1,1,1,1} b = stack_pop();
  var {1,1,1,1} x = stack_pop();
  charge_gas(5);
  var 1 bw = sat_word(b);
  var {1,1,1,1} r = u256_signextend(bw, x);
  stack_push(r);
  pc_add(1);
  return 0;
}

fun 1 op_lt() {
  var {1,1,1,1} x = stack_pop();
  var {1,1,1,1} y = stack_pop();
  charge_gas(3);
  var 1 r = u256_lt(x, y);
  stack_push_bool(r);
  pc_add(1);
  return 0;
}

fun 1 op_gt() {
  var {1,1,1,1} x = stack_pop();
  var {1,1,1,1} y = stack_pop();
