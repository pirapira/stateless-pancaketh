/* evm.pnk -- the EVM machine layer and non-system instructions: port of
   Vm.lean (BlockEnvironment, TransactionEnvironment, Message, Evm, stack,
   memory, gas charging), InstructionsCore.lean, InstructionsEnv.lean,
   Runtime.lean (jump destinations) and Gas.lean (memory/call gas).
   The current frame is the global `ev`; child frames swap it (Interpreter.lean
   frame model). EvmErr carries the ExceptionalHalt/Revert taxonomy.
   Requires: lib/*, state.pnk, header.pnk (calculate_blob_gas_price), tx.pnk. */

exception EvmErr : 1;
#define E_REVERT 1
#define E_STACK_UNDERFLOW 2
#define E_STACK_OVERFLOW 3
#define E_OUT_OF_GAS 4
#define E_INVALID_OPCODE 5
#define E_INVALID_JUMPDEST 6
#define E_STACK_DEPTH_LIMIT 7
#define E_WRITE_IN_STATIC 8
#define E_OUT_OF_BOUNDS_READ 9
#define E_INVALID_PARAMETER 10
#define E_INVALID_CONTRACT_PREFIX 11
#define E_ADDRESS_COLLISION 12
#define E_KZG_PROOF 13

/* BlockEnvironment */
#define BE_CHAIN_ID 0
#define BE_GAS_LIMIT 8
#define BE_BLOCK_HASHES 16
#define BE_BLOCK_HASHES_N 24
#define BE_COINBASE 32
#define BE_NUMBER 40
#define BE_BASE_FEE 48        /* U256 */
#define BE_TIME 80
#define BE_PREV_RANDAO 88
#define BE_EXCESS_BLOB_GAS 96
#define BE_PBBR 104
#define BE_SLOT 112
#define BE_PUBKEYS 120
#define BE_PUBKEYS_N 128
#define BE_SIZE 136

/* TransactionEnvironment */
#define TE_ORIGIN 0
#define TE_RECIPIENT 8        /* 0 = creation */
#define TE_VALUE 16           /* U256 */
#define TE_GAS_PRICE 48       /* U256 */
#define TE_GAS 80
#define TE_RESERVOIR 88
#define TE_AL_ADDRS 96        /* ptr to n address ptrs */
#define TE_AL_ADDRS_N 104
#define TE_AL_KEYS 112        /* ptr to n*52 bytes (addr||key) */
#define TE_AL_KEYS_N 120
#define TE_BLOB_HASHES 128
#define TE_BLOB_HASHES_N 136
#define TE_AUTHS 144          /* ptr to authorization records (tx.pnk layout) */
#define TE_AUTHS_N 152
#define TE_INDEX_SOME 160
#define TE_INDEX 168
#define TE_TX_HASH 176
#define TE_INTRINSIC_REGULAR 184
#define TE_INTRINSIC_STATE 192
#define TE_SIZE 200

/* Message */
#define MSG_BE 0
#define MSG_TE 8
#define MSG_CALLER 16
#define MSG_TARGET 24         /* 0 = creation */
#define MSG_CURRENT_TARGET 32
#define MSG_GAS 40
#define MSG_RESERVOIR 48
#define MSG_VALUE 56          /* U256 */
#define MSG_DATA 88
#define MSG_DATA_N 96
#define MSG_CODE_ADDRESS 104  /* 0 = none */
#define MSG_CODE 112
#define MSG_CODE_N 120
#define MSG_DEPTH 128
#define MSG_TRANSFER_VALUE 136
#define MSG_IS_STATIC 144
#define MSG_ACC_ADDRS 152     /* htab(20) */
#define MSG_ACC_KEYS 160      /* htab(52) */
#define MSG_DISABLE_PRECOMPILES 168
#define MSG_SIZE 176

/* Evm frame */
#define EV_PC 0
#define EV_STACK 8
#define EV_SP 16
#define EV_MEM 24
#define EV_MEM_LEN 32
#define EV_MEM_CAP 40
#define EV_CODE 48
#define EV_CODE_N 56
#define EV_GAS_LEFT 64
#define EV_STATE_GAS_LEFT 72
#define EV_JUMPDESTS 80
#define EV_LOGS 88            /* growable list of log record ptrs (8-byte elems) */
#define EV_REFUND 96          /* signed */
#define EV_RUNNING 104
#define EV_MSG 112
#define EV_OUTPUT 120
#define EV_OUTPUT_N 128
#define EV_DELETE 136         /* htab(20) accounts_to_delete */
#define EV_RETDATA 144
#define EV_RETDATA_N 152
#define EV_ERROR 160          /* 0 = none */
#define EV_ACC_ADDRS 168
#define EV_ACC_KEYS 176
#define EV_REGULAR_GAS_USED 184
#define EV_STATE_GAS_SPILLED 192
#define EV_AUTH_STATE_GAS_USED 200   /* signed */
#define EV_SIZE 208

/* Log record */
#define LOG_ADDRESS 0
#define LOG_TOPICS 8
#define LOG_TOPICS_N 16
#define LOG_DATA 24
#define LOG_DATA_N 32
#define LOG_SIZE 40

/* Gas constants (Gas.lean GasCosts / StateGasCosts / InstructionsCore) */
#define G_BASE 2
#define G_VERY_LOW 3
#define G_LOW 5
#define G_MID 8
#define G_HIGH 10
#define G_WARM_ACCESS 100
#define G_COLD_ACCOUNT_ACCESS 3000
#define G_COLD_STORAGE_ACCESS 3000
#define G_STORAGE_WRITE 10000
#define G_CALL_VALUE 10300
#define G_CALL_STIPEND 2300
#define G_ACCOUNT_WRITE 8000
#define G_CODE_DEPOSIT_PER_BYTE 200
#define G_CODE_INIT_PER_WORD 2
#define G_CREATE_ACCESS 11000
#define G_MEMORY_PER_WORD 3
#define G_FAST_STEP 5
#define G_REFUND_STORAGE_CLEAR 12480
#define G_KECCAK256_BASE 30
#define G_KECCAK256_PER_WORD 6
#define G_COPY_PER_WORD 3
#define G_LOG_BASE 375
#define G_LOG_DATA_PER_BYTE 8
#define G_LOG_TOPIC 375
#define G_EXP_BASE 10
#define G_EXP_PER_BYTE 50
#define G_SELFDESTRUCT_BASE 5000
#define G_BLOCKHASH 20
#define SG_COST_PER_STATE_BYTE 1530
#define SG_STORAGE_SET 97920
#define SG_NEW_ACCOUNT 183600
#define SG_AUTH_BASE 35190
#define STACK_DEPTH_LIMIT 1024
#define MAX_CODE_SIZE 65536
#define MAX_INIT_CODE_SIZE 131072
#define WORD_MAX 18446744073709551615

var 1 ev = 0;          /* current frame */

/* ---- small helpers ---------------------------------------------------- */

/* U256 -> word, saturating at WORD_MAX. */
fun 1 sat_word({1,1,1,1} v) {
  if (v.1 | v.2 | v.3) != 0 {
    return WORD_MAX;
  }
  return v.0;
}

fun 1 add_sat(1 a, 1 b) {
  var s = a + b;
  if s <+ a {
    return WORD_MAX;
  }
  return s;
}

/* ceil32(value) saturating */
fun 1 ceil32(1 v) {
  var r = v & 31;
  if r == 0 {
    return v;
  }
  var 1 s = add_sat(v, 32 - r);
  return s;
}

fun 1 words_of(1 n) {
  var 1 c = ceil32(n);
  return c >>> 5;
}

/* to_address_masked: low 20 bytes of a U256 -> fresh 20-byte buffer */
fun 1 to_address_masked({1,1,1,1} v) {
  var 1 a = alloc(24);
  st_be32(a, v.2);
  st_be64(a + 4, v.1);
  st_be64(a + 12, v.0);
  return a;
}

/* Address (20 bytes) -> U256 */
fun {1,1,1,1} address_to_u256(1 a) {
  var {1,1,1,1} v = u256_from_be(a, 20);
  return v;
}

fun 1 is_valid_delegation(1 code, 1 n) {
  if n != 23 {
    return 0;
  }
  if ((ld8 code) == 239) && ((ld8 (code + 1)) == 1) && ((ld8 (code + 2)) == 0) {
    return 1;
  }
  return 0;
}

/* ---- gas (Vm.lean) ----------------------------------------------------------- */

fun 1 check_gas(1 amount) {
  if (lds 1 (ev + EV_GAS_LEFT)) <+ amount {
    throw EvmErr E_OUT_OF_GAS;
  }
  return 0;
}

fun 1 charge_gas(1 amount) {
  var gl = lds 1 (ev + EV_GAS_LEFT);
  if gl <+ amount {
    throw EvmErr E_OUT_OF_GAS;
  }
  st ev + EV_GAS_LEFT, gl - amount;
  st ev + EV_REGULAR_GAS_USED, (lds 1 (ev + EV_REGULAR_GAS_USED)) + amount;
  return 0;
}

fun 1 charge_state_gas(1 amount) {
  var sgl = lds 1 (ev + EV_STATE_GAS_LEFT);
  var gl = lds 1 (ev + EV_GAS_LEFT);
  if sgl >=+ amount {
    st ev + EV_STATE_GAS_LEFT, sgl - amount;
    return 0;
  }
  var 1 tot = add_sat(sgl, gl);
  if tot >=+ amount {
    var rem = amount - sgl;
    st ev + EV_STATE_GAS_LEFT, 0;
    st ev + EV_GAS_LEFT, gl - rem;
    st ev + EV_STATE_GAS_SPILLED, (lds 1 (ev + EV_STATE_GAS_SPILLED)) + rem;
    return 0;
  }
  throw EvmErr E_OUT_OF_GAS;
  return 0;
}

fun 1 credit_state_gas_refund(1 amount) {
  var spilled = lds 1 (ev + EV_STATE_GAS_SPILLED);
  var 1 from_gl = min(amount, spilled);
  st ev + EV_GAS_LEFT, (lds 1 (ev + EV_GAS_LEFT)) + from_gl;
  st ev + EV_STATE_GAS_SPILLED, spilled - from_gl;
  st ev + EV_STATE_GAS_LEFT, (lds 1 (ev + EV_STATE_GAS_LEFT)) + (amount - from_gl);
  return 0;
}

/* frame_state_gas_used (signed): reservoir - state_gas_left + spilled */
fun 1 frame_state_gas_used(1 e) {
  var msg = lds 1 (e + EV_MSG);
  return (lds 1 (msg + MSG_RESERVOIR)) - (lds 1 (e + EV_STATE_GAS_LEFT)) + (lds 1 (e + EV_STATE_GAS_SPILLED));
}

fun 1 refill_frame_state_gas() {
  var msg = lds 1 (ev + EV_MSG);
  st ev + EV_GAS_LEFT, (lds 1 (ev + EV_GAS_LEFT)) + (lds 1 (ev + EV_STATE_GAS_SPILLED));
  st ev + EV_STATE_GAS_LEFT, lds 1 (msg + MSG_RESERVOIR);
  st ev + EV_STATE_GAS_SPILLED, 0;
  return 0;
}

/* ---- stack (Vm.lean stackPop / stackPush) ---------------------------------------- */

fun {1,1,1,1} stack_pop() {
  var sp = lds 1 (ev + EV_SP);
  if sp == 0 {
    throw EvmErr E_STACK_UNDERFLOW;
  }
  sp = sp - 1;
  st ev + EV_SP, sp;
  return lds {1,1,1,1} ((lds 1 (ev + EV_STACK)) + sp * 32);
}

fun 1 stack_push({1,1,1,1} v) {
  var sp = lds 1 (ev + EV_SP);
  if sp == 1024 {
    throw EvmErr E_STACK_OVERFLOW;
  }
  st (lds 1 (ev + EV_STACK)) + sp * 32, v;
  st ev + EV_SP, sp + 1;
  return 0;
}

fun 1 stack_push_word(1 w) {
  stack_push(<w, 0, 0, 0>);
  return 0;
}

fun 1 stack_push_bool(1 b) {
  if b != 0 {
    stack_push(<1, 0, 0, 0>);
  } else {
    stack_push(<0, 0, 0, 0>);
  }
  return 0;
}

/* ---- memory (Vm.lean / Gas.lean) ------------------------------------------------ */

fun 1 memory_gas_cost(1 size) {
  var 1 w = words_of(size);
  var {1,1} sq = mul64x64(w, w);
  if sq.1 != 0 {
    return WORD_MAX;
  }
  var 1 a = add_sat(w * G_MEMORY_PER_WORD, sq.0 >>> 9);
  return a;
}

/* calculate_gas_extend_memory for one (start, size) extension; returns
   <cost, expand_by>. Saturates on absurd offsets (cost then exceeds gas). */
fun {1,1} extend_memory_cost1({1,1,1,1} start, {1,1,1,1} size) {
  var 1 z = u256_is_zero(size);
  if z != 0 {
    return <0, 0>;
  }
  var 1 s = sat_word(start);
  var 1 n = sat_word(size);
  var 1 endp = add_sat(s, n);
  if endp == WORD_MAX {
    return <WORD_MAX, 0>;
  }
  var cur = lds 1 (ev + EV_MEM_LEN);
  var 1 before = ceil32(cur);
  var 1 after = ceil32(endp);
  if after <=+ before {
    return <0, 0>;
  }
  var 1 ca = memory_gas_cost(after);
  var 1 cb = memory_gas_cost(before);
  if ca == WORD_MAX {
    return <WORD_MAX, 0>;
  }
  return <ca - cb, after - before>;
}

/* Two extensions (call family): sequential like the reference. */
fun {1,1} extend_memory_cost2({1,1,1,1} s1, {1,1,1,1} n1, {1,1,1,1} s2, {1,1,1,1} n2) {
  var {1,1} a = extend_memory_cost1(s1, n1);
  if a.0 == WORD_MAX {
    return a;
  }
  /* second extension is measured against the size after the first */
  var saved = lds 1 (ev + EV_MEM_LEN);
  st ev + EV_MEM_LEN, saved + a.1;
  var {1,1} b = extend_memory_cost1(s2, n2);
  st ev + EV_MEM_LEN, saved;
  if b.0 == WORD_MAX {
    return b;
  }
  return <a.0 + b.0, a.1 + b.1>;
}

/* Grow frame memory by expand_by zero bytes. */
fun 1 extend_memory(1 expand_by) {
  if expand_by == 0 {
    return 0;
  }
  var len = lds 1 (ev + EV_MEM_LEN);
  var cap = lds 1 (ev + EV_MEM_CAP);
  var nlen = len + expand_by;
  if nlen >+ cap {
    var ncap = cap * 2;
    if ncap <+ nlen {
      ncap = nlen + 1024;
    }
    var 1 nm = alloc(ncap);
    memcpy(nm, lds 1 (ev + EV_MEM), len);
    st ev + EV_MEM, nm;
    st ev + EV_MEM_CAP, ncap;
  }
  memzero((lds 1 (ev + EV_MEM)) + len, expand_by);
  st ev + EV_MEM_LEN, nlen;
  return 0;
}

/* Charge base + memory extension, then extend. */
fun 1 charge_with_memory(1 base, {1,1,1,1} start, {1,1,1,1} size) {
  var {1,1} x = extend_memory_cost1(start, size);
  var 1 total = add_sat(base, x.0);
  charge_gas(total);
  extend_memory(x.1);
  return 0;
}

/* buffer_read(buffer, start, size): zero padded copy into a fresh buffer.
   start/size are saturated words (callers already bounded size by gas). */
fun 1 buffer_read(1 buf, 1 buf_len, 1 start, 1 size, 1 out) {
  var avail = 0;
  if start <+ buf_len {
    avail = buf_len - start;
    if avail >+ size {
      avail = size;
    }
    memcpy(out, buf + start, avail);
  }
  memzero(out + avail, size - avail);
  return 0;
}

/* Pointer into frame memory at a (gas-covered) offset. */
#define MEM_PTR(off) ((lds 1 (ev + EV_MEM)) + (off))

/* ---- jump destinations (Runtime.lean) ------------------------------------------- */

fun 1 compute_jumpdests(1 code, 1 n) {
  var 1 bm = alloc(((n + 63) >>> 6) * 8 + 8);
  memzero(bm, ((n + 63) >>> 6) * 8 + 8);
  var pc = 0;
  while pc <+ n {
    var op = ld8 (code + pc);
    var adv = 1;
    if op == 91 {
      st bm + (pc >>> 6) * 8, (lds 1 (bm + (pc >>> 6) * 8)) | (1 << (pc & 63));
    } else {
      if (op >=+ 96) && (op <=+ 127) {
        adv = op - 96 + 2;
      } else {
        if (op == 230) || (op == 231) {
          adv = 2;
          if pc + 1 <+ n {
            var nx = ld8 (code + pc + 1);
            if (nx >=+ 91) && (nx <=+ 127) {
              adv = 1;
            }
          }
        }
        if op == 232 {
          adv = 2;
          if pc + 1 <+ n {
            var nx2 = ld8 (code + pc + 1);
            if (nx2 >=+ 82) && (nx2 <=+ 127) {
              adv = 1;
            }
          }
        }
      }
    }
    pc = pc + adv;
  }
  return bm;
}

fun 1 is_valid_jumpdest({1,1,1,1} dest) {
  if (dest.1 | dest.2 | dest.3) != 0 {
    return 0;
  }
  var d = dest.0;
  if d >=+ (lds 1 (ev + EV_CODE_N)) {
    return 0;
  }
  var bm = lds 1 (ev + EV_JUMPDESTS);
  return ((lds 1 (bm + (d >>> 6) * 8)) >>> (d & 63)) & 1;
}

/* ---- frame construction --------------------------------------------------------- */

fun 1 msg_new() {
  var 1 m = alloc(MSG_SIZE);
  memzero(m, MSG_SIZE);
  return m;
}

/* A fresh frame for a message (process_message's childEvm). */
fun 1 frame_new(1 msg) {
  var 1 e = alloc(EV_SIZE);
  memzero(e, EV_SIZE);
  var 1 stk = alloc(1024 * 32);
  st e + EV_STACK, stk;
  var 1 mem = alloc(1024);
  st e + EV_MEM, mem;
  st e + EV_MEM_CAP, 1024;
  st e + EV_CODE, lds 1 (msg + MSG_CODE);
  st e + EV_CODE_N, lds 1 (msg + MSG_CODE_N);
  st e + EV_GAS_LEFT, lds 1 (msg + MSG_GAS);
  st e + EV_STATE_GAS_LEFT, lds 1 (msg + MSG_RESERVOIR);
  var 1 jd = compute_jumpdests(lds 1 (msg + MSG_CODE), lds 1 (msg + MSG_CODE_N));
  st e + EV_JUMPDESTS, jd;
  var 1 logs = lst_new(8, 4);
  st e + EV_LOGS, logs;
  st e + EV_RUNNING, 1;
  st e + EV_MSG, msg;
  var 1 del = htab_new(20, 4);
  st e + EV_DELETE, del;
  st e + EV_ACC_ADDRS, lds 1 (msg + MSG_ACC_ADDRS);
  st e + EV_ACC_KEYS, lds 1 (msg + MSG_ACC_KEYS);
  var 1 empty = alloc(8);
  st e + EV_OUTPUT, empty;
  st e + EV_RETDATA, empty;
  return e;
}

fun 1 pc_add(1 n) {
  st ev + EV_PC, (lds 1 (ev + EV_PC)) + n;
  return 0;
}

fun 1 cur_msg() {
  return lds 1 (ev + EV_MSG);
}

fun 1 require_not_static() {
  if (lds 1 ((lds 1 (ev + EV_MSG)) + MSG_IS_STATIC)) != 0 {
    throw EvmErr E_WRITE_IN_STATIC;
  }
  return 0;
}

/* accessed sets */
fun 1 is_warm_address(1 addr) {
  var 1 h = htab_has(lds 1 (ev + EV_ACC_ADDRS), addr);
  return h;
}

fun 1 warm_address(1 addr) {
  htab_set(lds 1 (ev + EV_ACC_ADDRS), addr, 1);
  return 0;
}

/* EIP-2929 access cost for an address (warms it). */
fun 1 access_gas_cost(1 addr) {
  var 1 w = is_warm_address(addr);
  if w != 0 {
    return G_WARM_ACCESS;
  }
  warm_address(addr);
  return G_COLD_ACCOUNT_ACCESS;
}

/* ---- arithmetic / comparison / bitwise (InstructionsCore.lean) ------------------- */

fun 1 op_add() {
  var {1,1,1,1} x = stack_pop();
  var {1,1,1,1} y = stack_pop();
  charge_gas(3);
  var {1,1,1,1} r = u256_add(x, y);
  stack_push(r);
  pc_add(1);
  return 0;
}

fun 1 op_mul() {
  var {1,1,1,1} x = stack_pop();
  var {1,1,1,1} y = stack_pop();
  charge_gas(5);
  var {1,1,1,1} r = u256_mul(x, y);
  stack_push(r);
  pc_add(1);
  return 0;
}

fun 1 op_sub() {
  var {1,1,1,1} x = stack_pop();
  var {1,1,1,1} y = stack_pop();
  charge_gas(3);
  var {1,1,1,1} r = u256_sub(x, y);
  stack_push(r);
  pc_add(1);
  return 0;
}

fun 1 op_div() {
  var {1,1,1,1} x = stack_pop();
  var {1,1,1,1} y = stack_pop();
  charge_gas(5);
  var {1,1,1,1} r = u256_div(x, y);
  stack_push(r);
  pc_add(1);
  return 0;
}

fun 1 op_sdiv() {
  var {1,1,1,1} x = stack_pop();
  var {1,1,1,1} y = stack_pop();
  charge_gas(5);
  var {1,1,1,1} r = u256_sdiv(x, y);
