fun 1 op_iszero() {
  var {1,1,1,1} x = stack_pop();
  charge_gas(3);
  var 1 r = u256_is_zero(x);
  stack_push_bool(r);
  pc_add(1);
  return 0;
}

fun 1 op_and() {
  var {1,1,1,1} x = stack_pop();
  var {1,1,1,1} y = stack_pop();
  charge_gas(3);
  stack_push(<x.0 & y.0, x.1 & y.1, x.2 & y.2, x.3 & y.3>);
  pc_add(1);
  return 0;
}

fun 1 op_or() {
  var {1,1,1,1} x = stack_pop();
  var {1,1,1,1} y = stack_pop();
  charge_gas(3);
  stack_push(<x.0 | y.0, x.1 | y.1, x.2 | y.2, x.3 | y.3>);
  pc_add(1);
  return 0;
}

fun 1 op_xor() {
  var {1,1,1,1} x = stack_pop();
  var {1,1,1,1} y = stack_pop();
  charge_gas(3);
  stack_push(<x.0 ^ y.0, x.1 ^ y.1, x.2 ^ y.2, x.3 ^ y.3>);
  pc_add(1);
  return 0;
}

fun 1 op_not() {
  var {1,1,1,1} x = stack_pop();
  charge_gas(3);
  stack_push(<x.0 ^ WORD_MAX, x.1 ^ WORD_MAX, x.2 ^ WORD_MAX, x.3 ^ WORD_MAX>);
  pc_add(1);
  return 0;
}

fun 1 op_byte() {
  var {1,1,1,1} i = stack_pop();
  var {1,1,1,1} x = stack_pop();
  charge_gas(3);
  var 1 iw = sat_word(i);
  var 1 r = u256_byte(iw, x);
  stack_push_word(r);
  pc_add(1);
  return 0;
}

fun 1 op_shl() {
  var {1,1,1,1} sh = stack_pop();
  var {1,1,1,1} x = stack_pop();
  charge_gas(3);
  var 1 n = sat_word(sh);
  var {1,1,1,1} r = u256_shl(x, n);
  stack_push(r);
  pc_add(1);
  return 0;
}

fun 1 op_shr() {
  var {1,1,1,1} sh = stack_pop();
  var {1,1,1,1} x = stack_pop();
  charge_gas(3);
  var 1 n = sat_word(sh);
  var {1,1,1,1} r = u256_shr(x, n);
  stack_push(r);
  pc_add(1);
  return 0;
}

fun 1 op_sar() {
  var {1,1,1,1} sh = stack_pop();
  var {1,1,1,1} x = stack_pop();
  charge_gas(3);
  var 1 n = sat_word(sh);
  var {1,1,1,1} r = u256_sar(x, n);
  stack_push(r);
  pc_add(1);
  return 0;
}

fun 1 op_clz() {
  var {1,1,1,1} x = stack_pop();
  charge_gas(5);
  var 1 bl = u256_bit_length(x);
  stack_push_word(256 - bl);
  pc_add(1);
  return 0;
}

/* ---- keccak ---------------------------------------------------------------------- */

fun 1 op_keccak() {
  var {1,1,1,1} start = stack_pop();
  var {1,1,1,1} size = stack_pop();
  var 1 n = sat_word(size);
  var 1 w = words_of(n);
  var {1,1} x = extend_memory_cost1(start, size);
  var 1 cost = add_sat(G_KECCAK256_BASE + G_KECCAK256_PER_WORD * w, x.0);
  charge_gas(cost);
  extend_memory(x.1);
  var 1 mark = heap_mark();
  var 1 out = alloc(32);
  var 1 s = sat_word(start);
  keccak256(MEM_PTR(s), n, out);
  var {1,1,1,1} v = u256_from_be(out, 32);
  heap_release(mark);
  stack_push(v);
  pc_add(1);
  return 0;
}

/* ---- control flow ----------------------------------------------------------------- */

fun 1 op_stop() {
  st ev + EV_RUNNING, 0;
  pc_add(1);
  return 0;
}

fun 1 op_jump() {
  var {1,1,1,1} dest = stack_pop();
  charge_gas(8);
  var 1 ok = is_valid_jumpdest(dest);
  if ok == 0 {
    throw EvmErr E_INVALID_JUMPDEST;
  }
  st ev + EV_PC, dest.0;
  return 0;
}

fun 1 op_jumpi() {
  var {1,1,1,1} dest = stack_pop();
  var {1,1,1,1} cond = stack_pop();
  charge_gas(10);
  var 1 z = u256_is_zero(cond);
  if z != 0 {
    pc_add(1);
    return 0;
  }
  var 1 ok = is_valid_jumpdest(dest);
  if ok == 0 {
    throw EvmErr E_INVALID_JUMPDEST;
  }
  st ev + EV_PC, dest.0;
  return 0;
}

fun 1 op_pc() {
  charge_gas(2);
  stack_push_word(lds 1 (ev + EV_PC));
  pc_add(1);
  return 0;
}

fun 1 op_gas() {
  charge_gas(2);
  stack_push_word(lds 1 (ev + EV_GAS_LEFT));
  pc_add(1);
  return 0;
}

fun 1 op_jumpdest() {
  charge_gas(1);
  pc_add(1);
  return 0;
}

/* ---- memory instructions ----------------------------------------------------------- */

fun 1 op_mstore() {
  var {1,1,1,1} start = stack_pop();
  var {1,1,1,1} value = stack_pop();
  charge_with_memory(3, start, <32, 0, 0, 0>);
  var 1 s = sat_word(start);
  u256_to_be32(value, MEM_PTR(s));
  pc_add(1);
  return 0;
}

fun 1 op_mstore8() {
  var {1,1,1,1} start = stack_pop();
  var {1,1,1,1} value = stack_pop();
  charge_with_memory(3, start, <1, 0, 0, 0>);
  var 1 s = sat_word(start);
  st8 MEM_PTR(s), value.0 & 255;
  pc_add(1);
  return 0;
}

fun 1 op_mload() {
  var {1,1,1,1} start = stack_pop();
  charge_with_memory(3, start, <32, 0, 0, 0>);
  var 1 s = sat_word(start);
  var {1,1,1,1} v = u256_from_be(MEM_PTR(s), 32);
  stack_push(v);
  pc_add(1);
  return 0;
}

fun 1 op_msize() {
  charge_gas(2);
  stack_push_word(lds 1 (ev + EV_MEM_LEN));
  pc_add(1);
  return 0;
}

fun 1 op_mcopy() {
  var {1,1,1,1} dst = stack_pop();
  var {1,1,1,1} src = stack_pop();
  var {1,1,1,1} len = stack_pop();
  var 1 n = sat_word(len);
  var 1 w = words_of(n);
  var {1,1} x = extend_memory_cost2(src, len, dst, len);
  var 1 cost = add_sat(3 + G_COPY_PER_WORD * w, x.0);
  charge_gas(cost);
  extend_memory(x.1);
  if n != 0 {
    var 1 d = sat_word(dst);
    var 1 s = sat_word(src);
    var 1 mark = heap_mark();
    var 1 tmp = alloc(n);
    memcpy(tmp, MEM_PTR(s), n);
    memcpy(MEM_PTR(d), tmp, n);
    heap_release(mark);
  }
  pc_add(1);
  return 0;
}

/* ---- stack instructions ------------------------------------------------------------- */

fun 1 op_pop() {
  var {1,1,1,1} x = stack_pop();
  charge_gas(2);
  pc_add(1);
  return 0;
}

fun 1 op_push(1 nbytes) {
  if nbytes == 0 {
    charge_gas(2);
  } else {
    charge_gas(3);
  }
  var 1 mark = heap_mark();
  var 1 tmp = alloc(32);
  buffer_read(lds 1 (ev + EV_CODE), lds 1 (ev + EV_CODE_N), (lds 1 (ev + EV_PC)) + 1, nbytes, tmp);
  var {1,1,1,1} v = u256_from_be(tmp, nbytes);
  heap_release(mark);
  stack_push(v);
  pc_add(1 + nbytes);
  return 0;
}

/* dup_n(item_number 0-indexed from top) */
fun 1 op_dup(1 item) {
  charge_gas(3);
  var sp = lds 1 (ev + EV_SP);
  if item >=+ sp {
    throw EvmErr E_STACK_UNDERFLOW;
  }
  var {1,1,1,1} v = lds {1,1,1,1} ((lds 1 (ev + EV_STACK)) + (sp - 1 - item) * 32);
  stack_push(v);
  pc_add(1);
  return 0;
}

fun 1 stack_swap_positions(1 i, 1 j) {
  var sp = lds 1 (ev + EV_SP);
  var stk = lds 1 (ev + EV_STACK);
  var pa = stk + (sp - 1 - i) * 32;
  var pb = stk + (sp - 1 - j) * 32;
  var {1,1,1,1} a = lds {1,1,1,1} pa;
  var {1,1,1,1} b = lds {1,1,1,1} pb;
  st pa, b;
  st pb, a;
  return 0;
}

/* swap_n(item_number): top with position item_number from the top */
fun 1 op_swap(1 item) {
  charge_gas(3);
  if item >=+ (lds 1 (ev + EV_SP)) {
    throw EvmErr E_STACK_UNDERFLOW;
  }
  stack_swap_positions(0, item);
  pc_add(1);
  return 0;
}

fun 1 code_imm() {
  var pc = lds 1 (ev + EV_PC);
  if pc + 1 <+ (lds 1 (ev + EV_CODE_N)) {
    return ld8 ((lds 1 (ev + EV_CODE)) + pc + 1);
  }
  return 0;
}

/* decode_single(x) */
fun 1 decode_single(1 x) {
  if (x <=+ 90) || (x >=+ 128) {
    return (x + 145) & 255;
  }
  throw EvmErr E_INVALID_PARAMETER;
  return 0;
}

fun 1 op_dupn() {
  charge_gas(3);
  var 1 imm = code_imm();
  var 1 n = decode_single(imm);
  if n >+ (lds 1 (ev + EV_SP)) {
    throw EvmErr E_STACK_UNDERFLOW;
  }
  var sp = lds 1 (ev + EV_SP);
  var {1,1,1,1} v = lds {1,1,1,1} ((lds 1 (ev + EV_STACK)) + (sp - n) * 32);
  stack_push(v);
  pc_add(2);
  return 0;
}

fun 1 op_swapn() {
  charge_gas(3);
  var 1 imm = code_imm();
  var 1 n = decode_single(imm);
  if n + 1 >+ (lds 1 (ev + EV_SP)) {
    throw EvmErr E_STACK_UNDERFLOW;
  }
  stack_swap_positions(0, n);
  pc_add(2);
  return 0;
}

fun 1 op_exchange() {
  charge_gas(3);
  var 1 imm = code_imm();
  if (imm >+ 81) && (imm <+ 128) {
    throw EvmErr E_INVALID_PARAMETER;
  }
  var k = imm ^ 143;
  var q = k >>> 4;
  var r = k & 15;
  var n = 0;
  var m = 0;
  if q <+ r {
    n = q + 1;
    m = r + 1;
  } else {
    n = r + 1;
    m = 29 - q;
  }
  var 1 mx = max(n, m);
  if mx + 1 >+ (lds 1 (ev + EV_SP)) {
    throw EvmErr E_STACK_UNDERFLOW;
  }
  stack_swap_positions(n, m);
  pc_add(2);
  return 0;
}

/* ---- logs --------------------------------------------------------------------------- */

fun 1 log_append(1 e, 1 log) {
  var 1 slot = lst_push(lds 1 (e + EV_LOGS), 8);
  st slot, log;
  return 0;
}

fun 1 op_log(1 ntopics) {
  var {1,1,1,1} start = stack_pop();
  var {1,1,1,1} size = stack_pop();
  var 1 topics = alloc(ntopics * 32 + 8);
  var i = 0;
  while i < ntopics {
    var {1,1,1,1} t = stack_pop();
    u256_to_be32(t, topics + i * 32);
    i = i + 1;
  }
  var 1 n = sat_word(size);
  var {1,1} x = extend_memory_cost1(start, size);
  var {1,1} dc = mul64x64(G_LOG_DATA_PER_BYTE, n);
  var 1 cost = add_sat(G_LOG_BASE + G_LOG_TOPIC * ntopics, x.0);
  if dc.1 != 0 {
    cost = WORD_MAX;
  } else {
    cost = add_sat(cost, dc.0);
  }
  charge_gas(cost);
  extend_memory(x.1);
  require_not_static();
  var 1 log = alloc(LOG_SIZE);
  st log + LOG_ADDRESS, lds 1 ((lds 1 (ev + EV_MSG)) + MSG_CURRENT_TARGET);
  st log + LOG_TOPICS, topics;
  st log + LOG_TOPICS_N, ntopics;
  var 1 data = alloc(n + 8);
  var 1 s = sat_word(start);
  memcpy(data, MEM_PTR(s), n);
  st log + LOG_DATA, data;
  st log + LOG_DATA_N, n;
  log_append(ev, log);
  pc_add(1);
  return 0;
}

/* ---- storage ----------------------------------------------------------------------- */

fun 1 is_warm_storage_key(1 addr, 1 key) {
  var 1 k = sk_make(addr, key);
  var 1 h = htab_has(lds 1 (ev + EV_ACC_KEYS), k);
  return h;
}

fun 1 warm_storage_key(1 addr, 1 key) {
  var 1 k = sk_make(addr, key);
  htab_set(lds 1 (ev + EV_ACC_KEYS), k, 1);
  return 0;
}

fun 1 op_sload() {
  var {1,1,1,1} kv = stack_pop();
  var 1 key = alloc(32);
  u256_to_be32(kv, key);
  var target = lds 1 ((lds 1 (ev + EV_MSG)) + MSG_CURRENT_TARGET);
  var 1 warm = is_warm_storage_key(target, key);
  if warm != 0 {
    charge_gas(G_WARM_ACCESS);
  } else {
    warm_storage_key(target, key);
    charge_gas(G_COLD_STORAGE_ACCESS);
  }
  var {1,1,1,1} v = get_storage(target, key);
  stack_push(v);
  pc_add(1);
  return 0;
}

fun 1 op_sstore() {
  require_not_static();
  var {1,1,1,1} kv = stack_pop();
  var {1,1,1,1} new_value = stack_pop();
  var 1 key = alloc(32);
  u256_to_be32(kv, key);
  var target = lds 1 ((lds 1 (ev + EV_MSG)) + MSG_CURRENT_TARGET);
  var 1 warm = is_warm_storage_key(target, key);
  var access_cost = G_WARM_ACCESS;
  if warm == 0 {
    access_cost = G_COLD_STORAGE_ACCESS;
  }
  var 1 mx = max(access_cost, G_CALL_STIPEND + 1);
  check_gas(mx);
  if warm == 0 {
    warm_storage_key(target, key);
  }
  var {1,1,1,1} original = get_storage_original(target, key);
  var {1,1,1,1} current = get_storage(target, key);
  var 1 oc = u256_eq(original, current);
  var 1 cn = u256_eq(current, new_value);
  var 1 on = u256_eq(original, new_value);
  var 1 oz = u256_is_zero(original);
  var 1 cz = u256_is_zero(current);
  var 1 nz = u256_is_zero(new_value);
  var gas_cost = access_cost;
  if (oc != 0) && (cn == 0) {
    gas_cost = gas_cost + G_STORAGE_WRITE;
  }
  if cn == 0 {
    if (oz == 0) && (cz == 0) && (nz != 0) {
      st ev + EV_REFUND, (lds 1 (ev + EV_REFUND)) + G_REFUND_STORAGE_CLEAR;
    }
    if (oz == 0) && (cz != 0) {
      st ev + EV_REFUND, (lds 1 (ev + EV_REFUND)) - G_REFUND_STORAGE_CLEAR;
    }
    if on != 0 {
      st ev + EV_REFUND, (lds 1 (ev + EV_REFUND)) + G_STORAGE_WRITE;
    }
  }
  var state_gas = 0;
  if (oc != 0) && (cn == 0) && (oz != 0) {
    state_gas = SG_STORAGE_SET;
  }
  if (cn == 0) && (on != 0) && (oz != 0) {
    credit_state_gas_refund(SG_STORAGE_SET);
  }
  charge_gas(gas_cost);
  charge_state_gas(state_gas);
  set_storage(target, key, new_value);
  pc_add(1);
  return 0;
}

fun 1 op_tload() {
  var {1,1,1,1} kv = stack_pop();
  charge_gas(100);
  var 1 key = alloc(32);
  u256_to_be32(kv, key);
  var target = lds 1 ((lds 1 (ev + EV_MSG)) + MSG_CURRENT_TARGET);
  var {1,1,1,1} v = get_transient_storage(target, key);
  stack_push(v);
  pc_add(1);
  return 0;
}

fun 1 op_tstore() {
  require_not_static();
  var {1,1,1,1} kv = stack_pop();
  var {1,1,1,1} v = stack_pop();
  charge_gas(100);
  var 1 key = alloc(32);
  u256_to_be32(kv, key);
  var target = lds 1 ((lds 1 (ev + EV_MSG)) + MSG_CURRENT_TARGET);
  set_transient_storage(target, key, v);
  pc_add(1);
  return 0;
}

/* ---- environment (InstructionsEnv.lean) ---------------------------------------------- */

fun 1 op_address() {
  charge_gas(2);
  var {1,1,1,1} v = address_to_u256(lds 1 ((lds 1 (ev + EV_MSG)) + MSG_CURRENT_TARGET));
  stack_push(v);
  pc_add(1);
  return 0;
}

fun 1 op_balance() {
  var {1,1,1,1} av = stack_pop();
  var 1 addr = to_address_masked(av);
  var 1 c = access_gas_cost(addr);
  charge_gas(c);
  var 1 a = get_account(addr);
  stack_push(lds {1,1,1,1} (a + ACCT_BALANCE));
  pc_add(1);
  return 0;
}

fun 1 op_origin() {
  charge_gas(2);
  var te = lds 1 ((lds 1 (ev + EV_MSG)) + MSG_TE);
  var {1,1,1,1} v = address_to_u256(lds 1 (te + TE_ORIGIN));
  stack_push(v);
  pc_add(1);
  return 0;
}

fun 1 op_caller() {
  charge_gas(2);
  var {1,1,1,1} v = address_to_u256(lds 1 ((lds 1 (ev + EV_MSG)) + MSG_CALLER));
  stack_push(v);
  pc_add(1);
  return 0;
}

fun 1 op_callvalue() {
  charge_gas(2);
  stack_push(lds {1,1,1,1} ((lds 1 (ev + EV_MSG)) + MSG_VALUE));
  pc_add(1);
  return 0;
}

fun 1 op_calldataload() {
  var {1,1,1,1} start = stack_pop();
  charge_gas(3);
  var msg = lds 1 (ev + EV_MSG);
  var 1 s = sat_word(start);
  var 1 mark = heap_mark();
  var 1 tmp = alloc(32);
  buffer_read(lds 1 (msg + MSG_DATA), lds 1 (msg + MSG_DATA_N), s, 32, tmp);
  var {1,1,1,1} v = u256_from_be(tmp, 32);
  heap_release(mark);
  stack_push(v);
  pc_add(1);
  return 0;
}

fun 1 op_calldatasize() {
  charge_gas(2);
  stack_push_word(lds 1 ((lds 1 (ev + EV_MSG)) + MSG_DATA_N));
  pc_add(1);
  return 0;
}

/* calldatacopy / codecopy shared shape: copy from (buf, buf_len). */
fun 1 copy_from_buffer(1 base, 1 buf, 1 buf_len) {
  var {1,1,1,1} mstart = stack_pop();
  var {1,1,1,1} dstart = stack_pop();
  var {1,1,1,1} size = stack_pop();
  var 1 n = sat_word(size);
  var 1 w = words_of(n);
  var {1,1} x = extend_memory_cost1(mstart, size);
  var 1 cost = add_sat(base + G_COPY_PER_WORD * w, x.0);
  charge_gas(cost);
  extend_memory(x.1);
  if n != 0 {
    var 1 ms = sat_word(mstart);
    var 1 ds = sat_word(dstart);
    buffer_read(buf, buf_len, ds, n, MEM_PTR(ms));
  }
  pc_add(1);
  return 0;
}

fun 1 op_calldatacopy() {
  var msg = lds 1 (ev + EV_MSG);
  copy_from_buffer(3, lds 1 (msg + MSG_DATA), lds 1 (msg + MSG_DATA_N));
  return 0;
}

fun 1 op_codesize() {
  charge_gas(2);
  stack_push_word(lds 1 (ev + EV_CODE_N));
  pc_add(1);
  return 0;
}

fun 1 op_codecopy() {
  copy_from_buffer(3, lds 1 (ev + EV_CODE), lds 1 (ev + EV_CODE_N));
  return 0;
}

fun 1 op_gasprice() {
  charge_gas(2);
  var te = lds 1 ((lds 1 (ev + EV_MSG)) + MSG_TE);
  stack_push(lds {1,1,1,1} (te + TE_GAS_PRICE));
  pc_add(1);
  return 0;
}

/* extCodeOf(address): <ptr, len> through the tracker */
fun {1,1} ext_code_of(1 addr) {
  var 1 a = get_account(addr);
  var {1,1} c = get_code(lds 1 (a + ACCT_CODE_HASH), addr);
  return c;
}

fun 1 op_extcodesize() {
  var {1,1,1,1} av = stack_pop();
  var 1 addr = to_address_masked(av);
  var 1 c = access_gas_cost(addr);
  charge_gas(c + G_WARM_ACCESS);
  var {1,1} code = ext_code_of(addr);
  stack_push_word(code.1);
  pc_add(1);
  return 0;
}

fun 1 op_extcodecopy() {
  var {1,1,1,1} av = stack_pop();
  var 1 addr = to_address_masked(av);
  var {1,1,1,1} mstart = stack_pop();
  var {1,1,1,1} cstart = stack_pop();
  var {1,1,1,1} size = stack_pop();
  var 1 n = sat_word(size);
  var 1 w = words_of(n);
  var {1,1} x = extend_memory_cost1(mstart, size);
  var 1 acc = access_gas_cost(addr);
  var 1 cost = add_sat(acc + G_WARM_ACCESS + G_COPY_PER_WORD * w, x.0);
  charge_gas(cost);
  extend_memory(x.1);
  var {1,1} code = ext_code_of(addr);
  if n != 0 {
    var 1 ms = sat_word(mstart);
    var 1 cs = sat_word(cstart);
    buffer_read(code.0, code.1, cs, n, MEM_PTR(ms));
  }
  pc_add(1);
  return 0;
}

fun 1 op_returndatasize() {
  charge_gas(2);
  stack_push_word(lds 1 (ev + EV_RETDATA_N));
  pc_add(1);
  return 0;
}

fun 1 op_returndatacopy() {
  var {1,1,1,1} mstart = stack_pop();
  var {1,1,1,1} rstart = stack_pop();
  var {1,1,1,1} size = stack_pop();
  var 1 n = sat_word(size);
  var 1 w = words_of(n);
  var {1,1} x = extend_memory_cost1(mstart, size);
  var 1 cost = add_sat(3 + G_COPY_PER_WORD * w, x.0);
  charge_gas(cost);
  var 1 rs = sat_word(rstart);
  var 1 endp = add_sat(rs, n);
  if endp >+ (lds 1 (ev + EV_RETDATA_N)) {
    throw EvmErr E_OUT_OF_BOUNDS_READ;
  }
  extend_memory(x.1);
  if n != 0 {
    var 1 ms = sat_word(mstart);
    memcpy(MEM_PTR(ms), (lds 1 (ev + EV_RETDATA)) + rs, n);
  }
  pc_add(1);
  return 0;
}

fun 1 op_extcodehash() {
  var {1,1,1,1} av = stack_pop();
  var 1 addr = to_address_masked(av);
  var 1 c = access_gas_cost(addr);
  charge_gas(c);
  var 1 a = get_account(addr);
  var 1 e = acct_is_empty(a);
  if e != 0 {
    stack_push(<0, 0, 0, 0>);
  } else {
    var {1,1,1,1} v = u256_from_be(lds 1 (a + ACCT_CODE_HASH), 32);
    stack_push(v);
  }
  pc_add(1);
  return 0;
}

fun 1 op_selfbalance() {
  charge_gas(G_FAST_STEP);
  var 1 a = get_account(lds 1 ((lds 1 (ev + EV_MSG)) + MSG_CURRENT_TARGET));
  stack_push(lds {1,1,1,1} (a + ACCT_BALANCE));
  pc_add(1);
  return 0;
}

fun 1 block_env() {
  return lds 1 ((lds 1 (ev + EV_MSG)) + MSG_BE);
}

fun 1 op_basefee() {
  charge_gas(2);
  var 1 benv = block_env();
  stack_push(lds {1,1,1,1} (benv + BE_BASE_FEE));
  pc_add(1);
  return 0;
}

fun 1 op_blobhash() {
  var {1,1,1,1} iv = stack_pop();
  charge_gas(3);
  var te = lds 1 ((lds 1 (ev + EV_MSG)) + MSG_TE);
  var n = lds 1 (te + TE_BLOB_HASHES_N);
  var 1 i = sat_word(iv);
  if i <+ n {
    var {1,1,1,1} v = u256_from_be((lds 1 (te + TE_BLOB_HASHES)) + i * 32, 32);
    stack_push(v);
  } else {
    stack_push(<0, 0, 0, 0>);
  }
  pc_add(1);
  return 0;
}

fun 1 op_blobbasefee() {
  charge_gas(2);
  var 1 benv = block_env();
  var {1,1,1,1} price = calculate_blob_gas_price(lds 1 (benv + BE_EXCESS_BLOB_GAS));
  stack_push(price);
  pc_add(1);
  return 0;
}

fun 1 op_blockhash() {
  var {1,1,1,1} bn = stack_pop();
  charge_gas(G_BLOCKHASH);
  var 1 benv = block_env();
  var current = lds 1 (benv + BE_NUMBER);
  var 1 b = sat_word(bn);
  if (current <=+ b) || (current >+ b + 256) || (b == WORD_MAX) {
    stack_push(<0, 0, 0, 0>);
    pc_add(1);
    return 0;
  }
  var offset = current - b;
  var n = lds 1 (benv + BE_BLOCK_HASHES_N);
  if offset >+ n {
    throw BlockErr 50;   /* BLOCKHASH beyond witness headers -> rejection */
  }
  var {1,1,1,1} h = u256_from_be((lds 1 (benv + BE_BLOCK_HASHES)) + (n - offset) * 32, 32);
  track_ancestor_access(offset);
  stack_push(h);
  pc_add(1);
  return 0;
}

fun 1 op_coinbase() {
  charge_gas(2);
  var 1 benv = block_env();
  var {1,1,1,1} v = address_to_u256(lds 1 (benv + BE_COINBASE));
  stack_push(v);
  pc_add(1);
  return 0;
}

fun 1 op_timestamp() {
  charge_gas(2);
